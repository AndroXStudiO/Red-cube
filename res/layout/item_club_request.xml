<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    android:id="@id/cardView"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_8dp"
    app:cardCornerRadius="@dimen/_12dp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/white"
        android:padding="@dimen/_16dp"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/llRequestType"
            android:background="@drawable/bg_black_100_solid"
            android:paddingLeft="@dimen/_8dp"
            android:paddingRight="@dimen/_8dp"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_24dp"
            android:paddingHorizontal="@dimen/_8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@id/ivBrand"
                android:layout_width="16.0dip"
                android:layout_height="16.0dip"
                android:src="@drawable/ic_brand_robi" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_12sp"
                android:textStyle="bold"
                android:textColor="@color/black_800"
                android:id="@id/tvRequestType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Sim"
                android:layout_marginStart="4.0dip" />
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_10sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@id/tvStatus"
            android:background="@drawable/bg_green_chip"
            android:paddingLeft="12.0dip"
            android:paddingRight="12.0dip"
            android:layout_width="wrap_content"
            android:layout_height="22.0dip"
            android:text="Delivered"
            android:paddingHorizontal="12.0dip"
            app:layout_constraintBottom_toBottomOf="@id/llRequestType"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/llRequestType" />
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@id/ivDelivery"
            android:layout_width="@dimen/_18dp"
            android:layout_height="@dimen/_18dp"
            android:layout_marginTop="@dimen/_16dp"
            android:src="@drawable/ic_truck"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llRequestType" />
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_12sp"
            android:textColor="@color/black_500"
            android:id="@id/tvDeliveryHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Expected Delivery Time"
            android:layout_marginStart="@dimen/_8dp"
            app:layout_constraintStart_toEndOf="@id/ivDelivery"
            app:layout_constraintTop_toTopOf="@id/ivDelivery" />
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_14sp"
            android:textStyle="bold"
            android:textColor="@color/black_800"
            android:id="@id/tvDeliveryTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4dp"
            android:layout_marginStart="@dimen/_8dp"
            app:layout_constraintStart_toEndOf="@id/ivDelivery"
            app:layout_constraintTop_toBottomOf="@id/tvDeliveryHeader" />
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@id/ivLocationMarker"
            android:layout_width="@dimen/_18dp"
            android:layout_height="@dimen/_18dp"
            android:layout_marginTop="@dimen/_16dp"
            android:src="@drawable/ic_location_marker"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDeliveryTime" />
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_12sp"
            android:textColor="@color/black_500"
            android:id="@id/tvDistanceHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Distance"
            android:layout_marginStart="@dimen/_8dp"
            app:layout_constraintStart_toEndOf="@id/ivLocationMarker"
            app:layout_constraintTop_toTopOf="@id/ivLocationMarker" />
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_14sp"
            android:textStyle="bold"
            android:textColor="@color/black_800"
            android:id="@id/tvDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4dp"
            android:layout_marginStart="@dimen/_8dp"
            app:layout_constraintStart_toEndOf="@id/ivLocationMarker"
            app:layout_constraintTop_toBottomOf="@id/tvDistanceHeader" />
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@id/ivOrderId"
            android:layout_width="@dimen/_18dp"
            android:layout_height="@dimen/_18dp"
            android:layout_marginTop="@dimen/_16dp"
            android:src="@drawable/ic_customer_profile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDistance" />
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_12sp"
            android:textColor="@color/black_500"
            android:id="@id/tvOrderIdHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Order ID"
            android:layout_marginStart="@dimen/_8dp"
            app:layout_constraintStart_toEndOf="@id/ivOrderId"
            app:layout_constraintTop_toTopOf="@id/ivOrderId" />
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_14sp"
            android:textStyle="bold"
            android:textColor="@color/black_800"
            android:id="@id/tvOrderId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4dp"
            android:text="-"
            android:layout_marginStart="@dimen/_8dp"
            app:layout_constraintStart_toEndOf="@id/ivOrderId"
            app:layout_constraintTop_toBottomOf="@id/tvOrderIdHeader" />
        <com.google.android.material.button.MaterialButton
            android:textSize="@dimen/_12sp"
            android:textStyle="bold"
            android:textColor="@color/red"
            android:id="@id/btnReject"
            android:background="@drawable/bg_dual_stroke_button"
            android:layout_width="0.0dip"
            android:layout_height="@dimen/_36dp"
            android:layout_marginTop="@dimen/_16dp"
            android:layout_marginBottom="@dimen/_4dp"
            android:text="Reject"
            android:insetTop="0.0dip"
            android:insetBottom="0.0dip"
            android:textAllCaps="false"
            android:layout_marginEnd="@dimen/_4dp"
            app:backgroundTint="@null"
            app:cornerRadius="@dimen/_32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnAccept"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvOrderId" />
        <com.google.android.material.button.MaterialButton
            android:textSize="@dimen/_12sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@id/btnAccept"
            android:layout_width="0.0dip"
            android:layout_height="@dimen/_36dp"
            android:layout_marginTop="@dimen/_16dp"
            android:layout_marginBottom="@dimen/_4dp"
            android:text="Accept"
            android:insetTop="0.0dip"
            android:insetBottom="0.0dip"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/_4dp"
            app:backgroundTint="@color/success_500"
            app:cornerRadius="@dimen/_32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnReject"
            app:layout_constraintTop_toBottomOf="@id/tvOrderId" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
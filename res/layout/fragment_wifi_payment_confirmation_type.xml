<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@id/guidelineStartMargin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/_16dp" />
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@id/guidelineEndMargin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/_16dp" />
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/_14sp"
        android:textStyle="bold"
        android:textColor="@color/black_800"
        android:id="@id/tvTitle"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_22dp"
        android:text="@string/select_type"
        app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
        app:layout_constraintTop_toTopOf="parent" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/clSimSelection"
        android:background="@drawable/bg_pin"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12dp"
        app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
        app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/clWithOtp"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/_52dp"
            android:layout_margin="@dimen/_4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_14sp"
                android:textStyle="bold"
                android:textColor="@color/black_800"
                android:id="@id/tvPhysicalSim"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/with_otp"
                android:layout_marginStart="@dimen/_12dp"
                android:layout_marginEnd="16.0dip"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <androidx.appcompat.widget.AppCompatImageView
                android:textColor="@color/black"
                android:id="@id/ivCheck1"
                android:layout_width="@dimen/_24dp"
                android:layout_height="@dimen/_24dp"
                android:layout_margin="@dimen/_8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_unchecked_gray_border" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/clWithoutOtp"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/_52dp"
            android:layout_margin="@dimen/_4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/clWithOtp">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_14sp"
                android:textStyle="bold"
                android:textColor="@color/black_800"
                android:id="@id/tvESim"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/without_otp"
                android:layout_marginStart="@dimen/_12dp"
                android:layout_marginEnd="16.0dip"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <androidx.appcompat.widget.AppCompatImageView
                android:textColor="@color/black"
                android:id="@id/ivCheck2"
                android:layout_width="@dimen/_24dp"
                android:layout_height="@dimen/_24dp"
                android:layout_margin="@dimen/_8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_unchecked_gray_border" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/clProceed"
        android:background="@drawable/bg_recharge_bottom_btn"
        android:layout_width="fill_parent"
        android:layout_height="108.0dip"
        android:elevation="@dimen/_8dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/llButton"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16dp"
            android:layout_marginBottom="@dimen/_16dp"
            android:layout_marginStart="@dimen/_16dp"
            android:layout_marginEnd="@dimen/_16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.google.android.material.button.MaterialButton
                android:textSize="@dimen/_16sp"
                android:id="@id/btnProceed"
                android:layout_width="0.0dip"
                android:layout_height="@dimen/_48dp"
                android:layout_margin="@dimen/_2dp"
                android:text="@string/next"
                android:layout_weight="1.0"
                android:insetTop="0.0dip"
                android:insetBottom="0.0dip"
                android:textAllCaps="false"
                app:cornerRadius="@dimen/_32dp"
                style="@style/Button_Red_Body.RechargePanel" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
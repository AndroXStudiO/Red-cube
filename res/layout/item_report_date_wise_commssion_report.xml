<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/clTopHeaderDate"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.cardview.widget.CardView
            android:id="@id/cvHeaderDate"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_4dp"
            android:layout_marginBottom="@dimen/_44dp"
            android:minHeight="@dimen/_48dp"
            app:cardCornerRadius="@dimen/_8dp"
            app:cardElevation="@dimen/_2dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_gravity="center"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@id/clDateHeader"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_12sp"
                        android:textColor="@color/black_500"
                        android:id="@id/textDateShow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Showing for"
                        android:layout_marginStart="@dimen/_12dp"
                        android:layout_marginEnd="8.0dip"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_12sp"
                        android:textStyle="bold"
                        android:textColor="@color/black_800"
                        android:id="@id/tvDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="31 Mar 2025"
                        android:layout_marginStart="8.0dip"
                        android:layout_marginEnd="8.0dip"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintEnd_toStartOf="@id/imageViewDate"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintStart_toEndOf="@id/textDateShow"
                        app:layout_constraintTop_toTopOf="parent" />
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@id/imageViewDate"
                        android:layout_width="@dimen/_20dp"
                        android:layout_height="@dimen/_20dp"
                        android:layout_marginEnd="@dimen/_14_5dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_calender" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/clTopDataView"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clTopHeaderDate">
        <androidx.cardview.widget.CardView
            android:id="@id/clDataView"
            android:paddingTop="@dimen/_12dp"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_4dp"
            android:layout_marginTop="@dimen/_32dp"
            app:cardCornerRadius="@dimen/_8dp"
            app:cardElevation="@dimen/_2dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@id/search_bar_layout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12dp"
                android:layout_marginBottom="@dimen/_12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@id/clHeader"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_12sp"
                        android:textStyle="bold"
                        android:textColor="@color/black_800"
                        android:id="@id/textTotalEarning"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Earnings"
                        android:layout_marginStart="@dimen/_12dp"
                        android:layout_marginEnd="8.0dip"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_12sp"
                        android:textStyle="bold"
                        android:textColor="@color/black_500"
                        android:id="@id/tvEarningDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="31 Mar 2025"
                        android:layout_marginStart="8.0dip"
                        android:layout_marginEnd="8.0dip"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintTop_toTopOf="parent" />
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@id/ivTaka"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_20dp"
                        android:layout_marginStart="@dimen/_12dp"
                        android:layout_marginEnd="@dimen/_5dp"
                        app:layout_constraintBottom_toBottomOf="@id/tvEarningAmount"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/textTotalEarning"
                        app:layout_constraintTop_toTopOf="@id/tvEarningAmount"
                        app:srcCompat="@drawable/ic_taka" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_20sp"
                        android:textStyle="bold"
                        android:textColor="@color/green_600"
                        android:id="@id/tvEarningAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8dp"
                        android:text="936"
                        android:layout_marginStart="@dimen/_4dp"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintStart_toEndOf="@id/ivTaka"
                        app:layout_constraintTop_toBottomOf="@id/textTotalEarning" />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@id/clHeaderBrand"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_12dp"
                    android:layout_marginEnd="@dimen/_12dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/clHeader">
                    <androidx.constraintlayout.widget.Guideline
                        android:orientation="vertical"
                        android:id="@id/guidelineMiddle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintGuide_percent="0.5" />
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.0"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="@dimen/_12sp"
                                android:textColor="@color/black_500"
                                android:id="@id/textEl"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_8dp"
                                android:text="@string/el"
                                android:layout_marginEnd="8.0dip"
                                app:layout_constrainedWidth="true"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@id/ivELTaka"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_8dp"
                                android:layout_marginStart="@dimen/_12dp"
                                android:layout_marginEnd="@dimen/_5dp"
                                app:layout_constraintEnd_toStartOf="@id/tvELAmount"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/textEl"
                                app:srcCompat="@drawable/ic_taka" />
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="@dimen/_12sp"
                                android:textStyle="bold"
                                android:textColor="@color/black_800"
                                android:id="@id/tvELAmount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_8dp"
                                android:text="300.20"
                                android:layout_marginEnd="8.0dip"
                                app:layout_constrainedWidth="true"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@id/ivELTaka"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/textEl" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.0"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="@dimen/_12sp"
                                android:textColor="@color/black_500"
                                android:id="@id/textSim"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_8dp"
                                android:text="@string/sim"
                                android:layout_marginEnd="8.0dip"
                                app:layout_constrainedWidth="true"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@id/ivSimTaka"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_8dp"
                                android:layout_marginStart="@dimen/_12dp"
                                android:layout_marginEnd="@dimen/_5dp"
                                app:layout_constraintEnd_toStartOf="@id/tvSim"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/textSim"
                                app:srcCompat="@drawable/ic_taka" />
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="@dimen/_12sp"
                                android:textStyle="bold"
                                android:textColor="@color/black_800"
                                android:id="@id/tvSim"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_8dp"
                                android:text="300.20"
                                android:layout_marginEnd="8.0dip"
                                app:layout_constrainedWidth="true"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@id/ivSimTaka"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/textSim" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.0"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="@dimen/_12sp"
                                android:textColor="@color/black_500"
                                android:id="@id/textCampaign"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_8dp"
                                android:text="@string/campaign"
                                android:layout_marginEnd="8.0dip"
                                app:layout_constrainedWidth="true"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@id/ivCampaignTaka"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_8dp"
                                android:layout_marginStart="@dimen/_12dp"
                                android:layout_marginEnd="@dimen/_5dp"
                                app:layout_constraintEnd_toStartOf="@id/tvCampaign"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/textCampaign"
                                app:srcCompat="@drawable/ic_taka" />
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="@dimen/_12sp"
                                android:textStyle="bold"
                                android:textColor="@color/black_800"
                                android:id="@id/tvCampaign"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_8dp"
                                android:text="300.20"
                                android:layout_marginEnd="8.0dip"
                                app:layout_constrainedWidth="true"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@id/ivCampaignTaka"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/textCampaign" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <View
                    android:id="@id/view2"
                    android:background="@color/divider_grey"
                    android:layout_width="0.0dip"
                    android:layout_height="1.0dip"
                    android:layout_marginTop="@dimen/_12dp"
                    android:layout_marginStart="@dimen/_12dp"
                    android:layout_marginEnd="@dimen/_12dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/clHeaderBrand" />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@id/clDownload"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11.0dip"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/view2">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@id/ivDownload"
                        android:layout_width="24.0dip"
                        android:layout_height="24.0dip"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_downloand" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_12sp"
                        android:textStyle="bold"
                        android:textColor="@color/nav_select"
                        android:id="@id/textDownload"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/download"
                        android:layout_marginStart="8.0dip"
                        android:layout_marginEnd="8.0dip"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintStart_toEndOf="@id/ivDownload"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
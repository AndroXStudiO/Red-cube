<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:background="@color/base_background"
    android:paddingTop="@dimen/_12dp"
    android:paddingBottom="@dimen/_36dp"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/_16dp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@id/ivRedcubeAppIcon"
        android:layout_width="@dimen/_42dp"
        android:layout_height="@dimen/_42dp"
        android:src="@drawable/ic_logo_new"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:layout_marginStart="@dimen/_8dp"
        app:layout_constraintBottom_toTopOf="@id/tvMyRobiAppTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:textSize="@dimen/_12sp"
        android:textColor="@color/black_800"
        android:id="@id/tvMyRobiAppTitle"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_2dp"
        android:text="@string/app_name"
        app:layout_constraintEnd_toEndOf="@id/ivRedcubeAppIcon"
        app:layout_constraintStart_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/ivRedcubeAppIcon"
        app:layout_constraintTop_toBottomOf="@id/ivRedcubeAppIcon" />
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="fill_parent"
        android:layout_marginStart="@dimen/_10dp"
        app:layout_constraintBottom_toBottomOf="@id/ivRedcubeAppIcon"
        app:layout_constraintStart_toEndOf="@id/ivRedcubeAppIcon"
        app:layout_constraintTop_toTopOf="@id/ivRedcubeAppIcon">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="fill_parent">
            <TextView
                android:textSize="@dimen/_12sp"
                android:textColor="@color/black_700"
                android:id="@id/tvRedcubeCurrentVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current Version"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <TextView
                android:textSize="@dimen/_10sp"
                android:textColor="@color/black_500"
                android:id="@id/tvCurrentVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3dp"
                android:text="Current Version: 6.0.0"
                android:layout_marginStart="@dimen/_5dp"
                app:layout_constraintBottom_toBottomOf="@id/tvRedcubeCurrentVersion"
                app:layout_constraintStart_toEndOf="@id/tvRedcubeCurrentVersion"
                app:layout_constraintTop_toTopOf="parent" />
            <androidx.constraintlayout.widget.Group
                android:id="@id/groupViewAvailableVersion"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="tvMyAvailableVersion,buttonUpdate" />
            <TextView
                android:textSize="@dimen/_10sp"
                android:textColor="@color/primary"
                android:id="@id/buttonUpdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5dp"
                android:text="@string/update"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvRedcubeCurrentVersion" />
            <TextView
                android:textSize="@dimen/_10sp"
                android:textColor="@color/black_500"
                android:id="@id/tvMyAvailableVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5dp"
                android:layout_marginStart="@dimen/_5dp"
                app:layout_constraintStart_toEndOf="@id/buttonUpdate"
                app:layout_constraintTop_toBottomOf="@id/tvRedcubeCurrentVersion" />
            <androidx.constraintlayout.widget.Guideline
                android:orientation="horizontal"
                android:id="@id/guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_begin="3.0dip" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
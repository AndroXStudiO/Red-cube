<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:background="@color/base_background"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <include
        android:id="@id/llTabs"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/layout_super_qr_tab_row" />
    <View
        android:id="@id/divider"
        android:background="@color/black_200"
        android:layout_width="0.0dip"
        android:layout_height="1.0dip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llTabs" />
    <androidx.cardview.widget.CardView
        android:id="@id/cvSearch"
        android:visibility="gone"
        android:layout_width="0.0dip"
        android:layout_height="@dimen/_40dp"
        android:layout_marginTop="@dimen/_12dp"
        android:layout_marginStart="@dimen/_16dp"
        android:layout_marginEnd="@dimen/_16dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/_8dp"
        app:cardElevation="1.0dip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/bg_search_border"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@id/ivSearch"
                android:layout_width="@dimen/_20dp"
                android:layout_height="@dimen/_20dp"
                android:layout_marginStart="@dimen/_12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_search"
                app:tint="@color/black_500" />
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="@dimen/_14sp"
                android:textColorHint="@color/black_500"
                android:id="@id/etSearch"
                android:background="@null"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:hint="Search by source/destination"
                android:singleLine="true"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:layout_marginStart="@dimen/_8dp"
                android:layout_marginEnd="@dimen/_12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivSearch"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@id/rvSuperQrOrders"
        android:paddingTop="@dimen/_8dp"
        android:paddingBottom="@dimen/_8dp"
        android:clipToPadding="false"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@id/barrierBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cvSearch" />
    <androidx.constraintlayout.widget.Barrier
        android:id="@id/barrierBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="top"
        app:constraint_referenced_ids="clOrderRequestBottom,clCompletedBottom" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/clOrderRequestBottom"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.google.android.material.button.MaterialButton
            android:textSize="@dimen/_16sp"
            android:textColor="@color/white"
            android:id="@id/btnRecharge"
            android:layout_width="0.0dip"
            android:layout_height="@dimen/_52dp"
            android:layout_marginTop="@dimen/_8dp"
            android:layout_marginBottom="@dimen/_16dp"
            android:text="Recharge"
            android:insetTop="0.0dip"
            android:insetBottom="0.0dip"
            android:layout_marginStart="@dimen/_16dp"
            android:layout_marginEnd="@dimen/_16dp"
            app:backgroundTint="@color/primary"
            app:cornerRadius="@dimen/_32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Button_Red" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/clCompletedBottom"
        android:visibility="gone"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.cardview.widget.CardView
            android:id="@id/cvDateDownload"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8dp"
            android:layout_marginStart="@dimen/_16dp"
            android:layout_marginEnd="@dimen/_16dp"
            app:cardCornerRadius="@dimen/_12dp"
            app:cardElevation="1.0dip"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:paddingTop="@dimen/_12dp"
                android:paddingBottom="@dimen/_4dp"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_12sp"
                    android:textColor="@color/black_500"
                    android:id="@id/tvShowingFor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/showing_for"
                    android:layout_marginStart="@dimen/_16dp"
                    app:layout_constraintBottom_toBottomOf="@id/ivCalendar"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_12sp"
                    android:textStyle="bold"
                    android:textColor="@color/black_800"
                    android:id="@id/tvSelectedDate"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_4dp"
                    app:layout_constraintBottom_toBottomOf="@id/ivCalendar"
                    app:layout_constraintEnd_toStartOf="@id/ivCalendar"
                    app:layout_constraintStart_toEndOf="@id/tvShowingFor"
                    app:layout_constraintTop_toTopOf="@id/tvShowingFor" />
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@id/ivCalendar"
                    android:layout_width="@dimen/_20dp"
                    android:layout_height="@dimen/_20dp"
                    android:layout_marginEnd="@dimen/_16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_calender" />
                <View
                    android:id="@id/viewDivider"
                    android:background="@color/divider_grey"
                    android:layout_width="0.0dip"
                    android:layout_height="1.0dip"
                    android:layout_marginTop="@dimen/_12dp"
                    android:layout_marginStart="@dimen/_16dp"
                    android:layout_marginEnd="@dimen/_16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ivCalendar" />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@id/clDownload"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10dp"
                    android:layout_marginBottom="@dimen/_12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/viewDivider">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@id/ivDownload"
                        android:layout_width="@dimen/_24dp"
                        android:layout_height="@dimen/_24dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_downloand"
                        app:tint="@color/primary" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_14sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:id="@id/tvDownload"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/download"
                        android:layout_marginStart="@dimen/_6dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/ivDownload"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <com.google.android.material.button.MaterialButton
            android:textSize="@dimen/_16sp"
            android:textColor="@color/white"
            android:id="@id/btnBackToHome"
            android:layout_width="0.0dip"
            android:layout_height="@dimen/_52dp"
            android:layout_marginTop="@dimen/_8dp"
            android:layout_marginBottom="@dimen/_16dp"
            android:text="Back to Home"
            android:insetTop="0.0dip"
            android:insetBottom="0.0dip"
            android:layout_marginStart="@dimen/_16dp"
            android:layout_marginEnd="@dimen/_16dp"
            app:backgroundTint="@color/primary"
            app:cornerRadius="@dimen/_32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cvDateDownload"
            style="@style/Button_Red" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
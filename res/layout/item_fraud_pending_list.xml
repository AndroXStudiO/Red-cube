<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/deviceCard"
    android:background="@drawable/bg_rounded_white"
    android:padding="16.0dip"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_4dp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <TextView
        android:textSize="16.0sp"
        android:textStyle="bold"
        android:textColor="#ff000000"
        android:id="@id/tvDeviceName"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:text="Name: Abdul Goni"
        android:layout_marginEnd="8.0dip"
        app:layout_constraintBottom_toTopOf="@id/tvRequestId"
        app:layout_constraintEnd_toStartOf="@id/tvOwnerDevice"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:textSize="12.0sp"
        android:textColor="#ff000000"
        android:id="@id/tvRequestId"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:text="Request ID: 1231"
        android:layout_marginEnd="@dimen/_8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDeviceName" />
    <TextView
        android:textSize="12.0sp"
        android:textColor="#ff000000"
        android:id="@id/tvRequestDate"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:text="Request Date : 7-Jul-2025"
        android:layout_marginEnd="@dimen/_8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvRequestId" />
    <TextView
        android:textSize="12.0sp"
        android:textColor="#ff000000"
        android:id="@id/tvDeviceModel"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvRequestDate" />
    <TextView
        android:textSize="11.0sp"
        android:textColor="#ff000000"
        android:id="@id/tvOwnerDevice"
        android:background="@drawable/bg_gray_border"
        android:paddingLeft="12.0dip"
        android:paddingTop="4.0dip"
        android:paddingRight="12.0dip"
        android:paddingBottom="4.0dip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12.0dip"
        android:paddingVertical="4.0dip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <com.google.android.material.button.MaterialButton
        android:textSize="@dimen/_12sp"
        android:textStyle="bold"
        android:id="@id/btnGenerateQr"
        android:layout_width="0.0dip"
        android:layout_height="@dimen/_32dp"
        android:layout_marginTop="@dimen/_8dp"
        android:layout_marginBottom="@dimen/_8dp"
        android:text="Generate QR"
        android:insetTop="@dimen/_0dp"
        android:insetBottom="@dimen/_0dp"
        android:textAllCaps="false"
        android:textAlignment="center"
        android:paddingStart="@dimen/_16dp"
        android:paddingEnd="@dimen/_16dp"
        app:cornerRadius="@dimen/_32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDeviceModel" />
    <TextView
        android:textSize="12.0sp"
        android:textColor="#ff000000"
        android:id="@id/tvWaitMsg"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8dp"
        android:text="@string/txt_pending_msg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnGenerateQr" />
</androidx.constraintlayout.widget.ConstraintLayout>
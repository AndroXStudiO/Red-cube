<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/deviceCard"
    android:background="@drawable/bg_rounded_white"
    android:padding="16.0dip"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_4dp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <TextView
        android:textSize="@dimen/_14sp"
        android:textStyle="bold"
        android:textColor="@color/black_800"
        android:id="@id/tvDeviceName"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:text="Samsung S23"
        android:layout_marginEnd="8.0dip"
        app:layout_constraintBottom_toTopOf="@id/tvOwnerName"
        app:layout_constraintEnd_toStartOf="@id/tvOwnerDevice"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <ImageView
        android:id="@id/ivDelete"
        android:layout_width="24.0dip"
        android:layout_height="24.0dip"
        android:src="@drawable/ic_delete"
        android:contentDescription="Delete"
        app:layout_constraintBottom_toBottomOf="@id/tvDeviceId"
        app:layout_constraintEnd_toEndOf="parent" />
    <TextView
        android:textSize="@dimen/_12sp"
        android:textColor="@color/black_800"
        android:id="@id/tvOwnerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDeviceName" />
    <TextView
        android:textSize="@dimen/_12sp"
        android:textColor="@color/black_800"
        android:id="@id/tvApprovedDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_4dp"
        android:text="Approved Date: 1-Jun-2025"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvOwnerName" />
    <TextView
        android:textSize="@dimen/_12sp"
        android:textColor="@color/black_800"
        android:id="@id/tvDeviceId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_4dp"
        android:text="Device ID: 1231"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvApprovedDate" />
    <TextView
        android:textSize="@dimen/_12sp"
        android:textColor="@color/black_500"
        android:id="@id/tvOwnerDevice"
        android:background="@drawable/bg_gray_border"
        android:paddingLeft="12.0dip"
        android:paddingTop="4.0dip"
        android:paddingRight="12.0dip"
        android:paddingBottom="4.0dip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Owner Device"
        android:paddingHorizontal="12.0dip"
        android:paddingVertical="4.0dip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <ImageView
        android:id="@id/ivMemberPhoto"
        android:visibility="gone"
        android:layout_width="88.0dip"
        android:layout_height="88.0dip"
        android:layout_marginTop="@dimen/_12dp"
        android:src="@drawable/profile"
        android:scaleType="centerCrop"
        android:contentDescription="Delete"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDeviceId" />
</androidx.constraintlayout.widget.ConstraintLayout>
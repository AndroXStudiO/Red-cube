<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:background="@color/page_background"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/main"
        android:background="@color/base_background"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@id/guidelineStartMargin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="@dimen/_16dp" />
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@id/guidelineEndMargin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="@dimen/_16dp" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/dsr_info"
            android:background="@drawable/bg_rectangle_shape"
            android:paddingBottom="@dimen/_12dp"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_14_5dp"
            android:layout_marginStart="@dimen/_16dp"
            android:layout_marginEnd="@dimen/_16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <bd.com.robi.redcube.custom_view.CircularImageView
                android:id="@id/imageViewProfile"
                android:background="@drawable/ic_profile_placeholder"
                android:layout_width="76.0dip"
                android:layout_height="76.0dip"
                android:layout_marginTop="@dimen/_12dp"
                android:scaleType="centerCrop"
                android:layout_marginStart="@dimen/_12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_14sp"
                android:textColor="@color/grey_800"
                android:gravity="center_horizontal"
                android:id="@id/txtDesignation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12dp"
                android:text="@string/dsr"
                android:layout_marginStart="@dimen/_12dp"
                android:layout_marginEnd="@dimen/_16dp"
                app:layout_constraintStart_toEndOf="@id/imageViewProfile"
                app:layout_constraintTop_toTopOf="parent" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_14sp"
                android:textStyle="bold"
                android:textColor="@color/black_800"
                android:gravity="center_horizontal"
                android:id="@id/txtName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2dp"
                android:layout_marginStart="@dimen/_12dp"
                android:layout_marginEnd="@dimen/_16dp"
                app:layout_constraintStart_toEndOf="@id/imageViewProfile"
                app:layout_constraintTop_toBottomOf="@id/txtDesignation" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_14sp"
                android:textColor="@color/black_800"
                android:gravity="center_horizontal"
                android:id="@id/txtMobile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2dp"
                android:layout_marginStart="@dimen/_12dp"
                android:layout_marginEnd="@dimen/_16dp"
                app:layout_constraintStart_toEndOf="@id/imageViewProfile"
                app:layout_constraintTop_toBottomOf="@id/txtName" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_14sp"
                android:textColor="@color/black_500"
                android:gravity="center_horizontal"
                android:id="@id/txtAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2dp"
                android:text="শাহিন টেলিকম, সাভার, ঢাকা"
                android:layout_marginStart="@dimen/_12dp"
                android:layout_marginEnd="@dimen/_16dp"
                app:layout_constraintStart_toEndOf="@id/imageViewProfile"
                app:layout_constraintTop_toBottomOf="@id/txtMobile" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@id/recycleView"
            android:paddingTop="@dimen/_12dp"
            android:paddingBottom="@dimen/_12dp"
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:layout_marginBottom="@dimen/_10dp"
            android:layout_marginStart="@dimen/_16dp"
            android:layout_marginEnd="@dimen/_16dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toTopOf="@id/clProceed"
            app:layout_constraintEnd_toStartOf="@id/guidelineEndMargin"
            app:layout_constraintStart_toEndOf="@id/guidelineStartMargin"
            app:layout_constraintTop_toBottomOf="@id/dsr_info" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/clProceed"
            android:background="@drawable/bg_recharge_bottom_btn"
            android:layout_width="fill_parent"
            android:layout_height="108.0dip"
            android:elevation="@dimen/_8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="1.0">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16dp"
                android:layout_marginBottom="@dimen/_16dp"
                android:layout_marginStart="@dimen/_16dp"
                android:layout_marginEnd="@dimen/_16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_16sp"
                    android:textColor="@color/black_500"
                    android:gravity="center"
                    android:id="@id/btnBack"
                    android:layout_width="fill_parent"
                    android:layout_height="@dimen/_48dp"
                    android:layout_margin="@dimen/_2dp"
                    android:text="@string/back"
                    android:layout_weight="1.0"
                    android:textAllCaps="false"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTC" />
                <com.google.android.material.button.MaterialButton
                    android:textSize="@dimen/_16sp"
                    android:id="@id/btnProceed"
                    android:layout_width="fill_parent"
                    android:layout_height="@dimen/_48dp"
                    android:layout_margin="@dimen/_2dp"
                    android:text="@string/proceed"
                    android:layout_weight="1.0"
                    android:insetTop="0.0dip"
                    android:insetBottom="0.0dip"
                    android:textAllCaps="false"
                    app:cornerRadius="@dimen/_32dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTC"
                    style="@style/Button_Red_Body.RechargePanel" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
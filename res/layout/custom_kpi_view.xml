<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <TextView
        android:textSize="@dimen/_12sp"
        android:textStyle="bold"
        android:textColor="@color/black_800"
        android:id="@id/kpiTitleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="KPI Title Placeholder:"
        android:paddingStart="@dimen/_4dp" />
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <ProgressBar
            android:id="@id/kpiProgressBar"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/_8dp"
            android:max="100"
            android:progress="5"
            android:progressDrawable="@drawable/custom_progress_bar"
            android:layout_centerVertical="true"
            android:paddingStart="@dimen/_4dp"
            android:paddingEnd="@dimen/_8dp"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal" />
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@id/progressImg"
            android:padding="@dimen/_0dp"
            android:layout_width="@dimen/_34dp"
            android:layout_height="@dimen/_34dp"
            android:scaleType="fitCenter"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            app:srcCompat="@drawable/ic_milestone_not_done" />
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/_11sp"
            android:textStyle="bold"
            android:textColor="@color/green_400"
            android:id="@id/achievedValueTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Achieved: 0"
            android:paddingStart="@dimen/_4dp"
            android:layout_alignParentStart="true" />
        <TextView
            android:textSize="@dimen/_11sp"
            android:textStyle="bold"
            android:textColor="@color/green_400"
            android:id="@id/remainingValueTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Remaining: 100"
            android:paddingEnd="@dimen/_4dp"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>
</LinearLayout>
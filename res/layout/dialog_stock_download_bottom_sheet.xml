<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_common_bottom"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        app:layout_constrainedHeight="true"
        app:layout_constraintVertical_bias="1.0">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@id/guidelineStartMargin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="@dimen/_16dp" />
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@id/guidelineEndMargin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="@dimen/_16dp" />
        <View
            android:id="@id/view2"
            android:background="@drawable/bg_bottom_sheet_header_shape"
            android:layout_width="@dimen/_32dp"
            android:layout_height="4.0dip"
            android:layout_marginTop="@dimen/_24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@id/ivClose"
            android:visibility="invisible"
            android:layout_width="@dimen/_24dp"
            android:layout_height="@dimen/_24dp"
            android:layout_marginTop="@dimen/_13dp"
            android:layout_marginEnd="@dimen/_19dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_grey_close" />
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_12sp"
            android:textStyle="bold"
            android:textColor="@color/black_800"
            android:id="@id/textRecivedStock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12dp"
            android:text="@string/avaiable_stock"
            android:layout_marginStart="5.0dip"
            android:layout_marginEnd="8.0dip"
            app:layout_constrainedWidth="true"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
            app:layout_constraintTop_toBottomOf="@id/view2" />
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_12sp"
            android:textStyle="bold"
            android:textColor="@color/nav_select"
            android:id="@id/textClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12dp"
            android:text="@string/close"
            android:layout_marginStart="5.0dip"
            android:layout_marginEnd="8.0dip"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintTop_toBottomOf="@id/view2" />
        <View
            android:id="@id/view1"
            android:background="@drawable/bg_bottom_sheet_header_shape"
            android:layout_width="0.0dip"
            android:layout_height="1.0dip"
            android:layout_marginTop="@dimen/_12dp"
            app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
            app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
            app:layout_constraintTop_toBottomOf="@id/textRecivedStock" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@id/recyclerView"
            android:paddingBottom="@dimen/_4dp"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
            app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
            app:layout_constraintTop_toBottomOf="@id/view1"
            app:spanCount="2" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/clMiddle"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/ivClose">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@id/clLastMonthList"
                android:background="@drawable/bg_rectangle_shape"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_14_5dp"
                android:layout_marginStart="@dimen/_12dp"
                android:layout_marginEnd="@dimen/_12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_12sp"
                    android:textStyle="bold"
                    android:textColor="@color/black_800"
                    android:id="@id/textLastMonthsSim"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12dp"
                    android:text="Last month's SIM sales"
                    android:layout_marginStart="5.0dip"
                    android:layout_marginEnd="8.0dip"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_12sp"
                    android:textColor="@color/black_500"
                    android:id="@id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4dp"
                    android:text="Time:"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_12sp"
                    android:textColor="@color/black_500"
                    android:id="@id/tvTimeValue"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4dp"
                    android:text="16/03/2025"
                    android:layout_marginStart="@dimen/_2dp"
                    app:layout_constraintStart_toEndOf="@id/tvTime"
                    app:layout_constraintTop_toTopOf="parent" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_12sp"
                    android:textColor="@color/black_500"
                    android:id="@id/tvFrom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2dp"
                    android:text="Recieved From:"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTime" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_12sp"
                    android:textColor="@color/black_500"
                    android:id="@id/tvFromValue"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2dp"
                    android:text="1873478797 - Test DSR JIA"
                    android:layout_marginStart="@dimen/_4dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvFrom"
                    app:layout_constraintTop_toBottomOf="@id/tvTime" />
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/llHeaderBrandEl"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10dp"
                    app:layout_constraintTop_toBottomOf="@id/tvFromValue">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_11sp"
                        android:textColor="@color/black_500"
                        android:gravity="center"
                        android:id="@id/textName"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="Name"
                        android:layout_weight="1.0" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_11sp"
                        android:textColor="@color/black_500"
                        android:gravity="center"
                        android:id="@id/textUPrice"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="U.Price"
                        android:layout_weight="1.0" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_11sp"
                        android:textColor="@color/black_500"
                        android:gravity="center"
                        android:id="@id/textQty"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="Qty"
                        android:layout_weight="1.0" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_11sp"
                        android:textColor="@color/black_500"
                        android:gravity="center"
                        android:id="@id/textViewTotal"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="Total"
                        android:layout_weight="1.0" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@id/rvRequest"
                android:paddingBottom="@dimen/_4dp"
                android:visibility="gone"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12dp"
                android:layout_marginStart="@dimen/_12dp"
                android:layout_marginEnd="@dimen/_12dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/clLastMonthList"
                app:spanCount="2" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_14sp"
                android:textStyle="bold"
                android:textColor="@color/black_800"
                android:id="@id/textTotalOrederAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12dp"
                android:text="@string/total_order_amount"
                android:layout_marginStart="@dimen/_12dp"
                android:layout_marginEnd="8.0dip"
                app:layout_constrainedWidth="true"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rvRequest" />
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@id/ivRobiTaka"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_6dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvTotal"
                app:layout_constraintTop_toBottomOf="@id/rvRequest"
                app:srcCompat="@drawable/ic_taka" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_12sp"
                android:textStyle="bold"
                android:textColor="@color/black_800"
                android:id="@id/tvTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12dp"
                android:layout_marginBottom="@dimen/_12dp"
                android:text=""
                android:layout_marginStart="@dimen/_4dp"
                android:layout_marginEnd="@dimen/_20dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintTop_toBottomOf="@id/rvRequest" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/clRechargeButton"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_24dp"
            android:layout_marginBottom="@dimen/_36dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
            app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
            app:layout_constraintTop_toBottomOf="@id/recyclerView">
            <com.google.android.material.button.MaterialButton
                android:textSize="@dimen/_14sp"
                android:id="@id/btnRecharge"
                android:visibility="gone"
                android:layout_width="0.0dip"
                android:layout_height="@dimen/_48dp"
                android:layout_margin="@dimen/_2dp"
                android:text="@string/download"
                android:layout_weight="1.0"
                android:insetTop="0.0dip"
                android:insetBottom="0.0dip"
                android:textAllCaps="false"
                android:translationZ="1.0dip"
                app:cornerRadius="@dimen/_32dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Button_Red_Body.RechargePanel" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
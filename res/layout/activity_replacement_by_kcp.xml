<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/main"
    android:background="@color/base_background"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/clFirst"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/progressIndicatorContainer"
            android:layout_width="0.0dip"
            android:layout_height="@dimen/_4dp"
            android:layout_marginTop="@dimen/_2dp"
            android:layout_marginStart="@dimen/_16dp"
            android:layout_marginEnd="@dimen/_16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/llSteps"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2dp"
            android:minHeight="@dimen/_14dp"
            android:layout_marginStart="@dimen/_16dp"
            android:layout_marginEnd="@dimen/_16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/progressIndicatorContainer">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_10sp"
                android:textStyle="normal"
                android:textColor="@color/black_500"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sim_steps"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_10sp"
                android:textStyle="normal"
                android:textColor="@color/black_500"
                android:id="@id/tvStepCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sim_steps"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.viewpager2.widget.ViewPager2
            android:id="@id/viewPager"
            android:layout_width="0.0dip"
            android:layout_height="0.0dip"
            android:layout_marginTop="16.0dip"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llSteps" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@id/guidelineStartMargin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="@dimen/_16dp" />
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@id/guidelineEndMargin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="@dimen/_16dp" />
        <androidx.constraintlayout.widget.Group
            android:id="@id/groupSimSerialInfoInput"
            android:visibility="visible"
            android:layout_width="0.0dip"
            android:layout_height="0.0dip"
            app:constraint_referenced_ids="tvEnterSimSerial, etSimSerialNo,btnScan" />
        <com.google.android.material.button.MaterialButton
            android:enabled="true"
            android:textSize="@dimen/_14sp"
            android:id="@id/btnScan"
            android:layout_width="0.0dip"
            android:layout_height="@dimen/_36dp"
            android:layout_marginTop="@dimen/_22dp"
            android:text="@string/scan"
            android:insetTop="0.0dip"
            android:insetBottom="0.0dip"
            android:textAllCaps="false"
            android:paddingStart="@dimen/_12dp"
            android:paddingEnd="@dimen/_12dp"
            app:cornerRadius="@dimen/_42dp"
            app:icon="@drawable/ic_scan"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/_4dp"
            app:iconTint="@color/text_color_red_grey_recharge_panel"
            app:layout_constrainedHeight="true"
            app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0"
            style="@style/Button_Red_Border_Only.RechargePanel" />
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_14sp"
            android:textStyle="bold"
            android:textColor="@color/black_800"
            android:id="@id/tvEnterSimSerial"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="0.0dip"
            android:layout_marginTop="35.0dip"
            android:text="@string/input_serial_number"
            app:layout_constraintEnd_toStartOf="@id/btnScan"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
            app:layout_constraintTop_toTopOf="parent" />
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="16.0sp"
            android:textColor="@color/black_800"
            android:id="@id/etSimSerialNo"
            android:background="@drawable/bg_number_input"
            android:padding="12.0dip"
            android:layout_width="fill_parent"
            android:layout_height="52.0dip"
            android:layout_margin="16.0dip"
            android:layout_marginTop="@dimen/_12dp"
            android:hint="XXX"
            android:maxLength="17"
            android:drawablePadding="@dimen/_2dp"
            android:inputType="number"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvEnterSimSerial" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/clProceed"
            android:background="@drawable/bg_recharge_bottom_btn"
            android:layout_width="fill_parent"
            android:layout_height="108.0dip"
            android:elevation="@dimen/_8dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="1.0">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/layoutClProceed"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16dp"
                android:layout_marginBottom="@dimen/_16dp"
                android:layout_marginStart="@dimen/_16dp"
                android:layout_marginEnd="@dimen/_16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_16sp"
                    android:textColor="@color/black_500"
                    android:gravity="center"
                    android:id="@id/btnBack"
                    android:layout_width="fill_parent"
                    android:layout_height="@dimen/_48dp"
                    android:layout_margin="@dimen/_2dp"
                    android:text="@string/back"
                    android:layout_weight="1.0"
                    android:textAllCaps="false"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTC" />
                <com.google.android.material.button.MaterialButton
                    android:textSize="@dimen/_16sp"
                    android:id="@id/btnProceed"
                    android:layout_width="fill_parent"
                    android:layout_height="@dimen/_48dp"
                    android:layout_margin="@dimen/_2dp"
                    android:text="@string/proceed"
                    android:layout_weight="1.0"
                    android:insetTop="0.0dip"
                    android:insetBottom="0.0dip"
                    android:textAllCaps="false"
                    app:cornerRadius="@dimen/_32dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTC"
                    style="@style/Button_Red_Body.RechargePanel" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="top"
        android:layout_gravity="top"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_40dp">
        <androidx.cardview.widget.CardView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_12dp"
            android:layout_marginBottom="@dimen/_8dp"
            app:cardCornerRadius="@dimen/_16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_12sp"
                    android:textColor="@color/black"
                    android:id="@id/tvRechargeText"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_14dp"
                    android:text="@string/recharge_at_robi_airtel_number"
                    android:layout_marginStart="@dimen/_12dp"
                    android:layout_marginEnd="@dimen/_12dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@id/ivCross"
                    android:padding="@dimen/_2dp"
                    android:layout_width="@dimen/_20dp"
                    android:layout_height="@dimen/_20dp"
                    android:layout_marginEnd="@dimen/_12dp"
                    app:layout_constraintBottom_toBottomOf="@id/tvRechargeText"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvRechargeText"
                    app:srcCompat="@drawable/ic_cross" />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@id/clRechargePanel"
                    android:layout_width="fill_parent"
                    android:layout_height="@dimen/_40dp"
                    android:layout_marginTop="@dimen/_12dp"
                    app:layout_constraintTop_toBottomOf="@id/tvRechargeText">
                    <androidx.constraintlayout.widget.Guideline
                        android:orientation="vertical"
                        android:id="@id/guidelineRight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintGuide_percent="0.6" />
                    <bd.com.robi.redcube.ui.login.AnimatedHintEditText
                        android:textSize="@dimen/_14sp"
                        android:textColor="@color/black"
                        android:textColorHint="@color/black_500"
                        android:id="@id/etMsisdn"
                        android:background="@null"
                        android:layout_width="0.0dip"
                        android:layout_height="0.0dip"
                        android:maxLength="11"
                        android:inputType="numberSigned"
                        android:imeOptions="actionNext"
                        android:nextFocusForward="@id/etAmount"
                        android:paddingStart="@dimen/_4dp"
                        android:paddingEnd="@dimen/_4dp"
                        android:layout_marginStart="@dimen/_12dp"
                        app:layout_constraintBottom_toTopOf="@id/view1"
                        app:layout_constraintEnd_toStartOf="@id/ivContact"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                    <View
                        android:id="@id/view1"
                        android:background="@color/divider_grey"
                        android:layout_width="0.0dip"
                        android:layout_height="1.0dip"
                        android:layout_marginEnd="@dimen/_8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/ivContact"
                        app:layout_constraintStart_toStartOf="@id/etMsisdn" />
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@id/ivContact"
                        android:padding="@dimen/_4dp"
                        android:layout_width="@dimen/_32dp"
                        android:layout_height="@dimen/_32dp"
                        android:layout_marginEnd="@dimen/_2dp"
                        app:layout_constraintBottom_toBottomOf="@id/etMsisdn"
                        app:layout_constraintEnd_toEndOf="@id/guidelineRight"
                        app:layout_constraintTop_toTopOf="@id/etMsisdn"
                        app:srcCompat="@drawable/ic_contacts" />
                    <androidx.appcompat.widget.AppCompatEditText
                        android:textSize="@dimen/_14sp"
                        android:textColor="@color/black"
                        android:textColorHint="@color/grey"
                        android:id="@id/etAmount"
                        android:background="@null"
                        android:layout_width="0.0dip"
                        android:layout_height="@dimen/_40dp"
                        android:hint=""
                        android:maxLength="5"
                        android:inputType="numberSigned"
                        android:imeOptions="actionDone"
                        android:drawableStart="@drawable/ic_taka"
                        android:paddingStart="@dimen/_8dp"
                        android:paddingEnd="@dimen/_4dp"
                        android:layout_marginStart="@dimen/_4dp"
                        app:layout_constraintBottom_toTopOf="@id/view2"
                        app:layout_constraintEnd_toStartOf="@id/ivAdd"
                        app:layout_constraintStart_toEndOf="@id/guidelineRight"
                        app:layout_constraintTop_toTopOf="parent" />
                    <View
                        android:id="@id/view2"
                        android:background="@color/divider_grey"
                        android:layout_width="0.0dip"
                        android:layout_height="1.0dip"
                        android:layout_marginStart="@dimen/_8dp"
                        android:layout_marginEnd="@dimen/_8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/etAmount"
                        app:layout_constraintStart_toStartOf="@id/etAmount" />
                    <androidx.appcompat.widget.AppCompatImageView
                        android:enabled="false"
                        android:id="@id/ivAdd"
                        android:padding="@dimen/_2dp"
                        android:layout_width="@dimen/_32dp"
                        android:layout_height="@dimen/_32dp"
                        android:layout_marginEnd="@dimen/_12dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_add_recharge_item"
                        app:tint="@color/add_recharge_icon_color_tint" />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_10sp"
                    android:textColor="@color/primary"
                    android:id="@id/tvMsisdnErrorMessage"
                    android:visibility="gone"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4dp"
                    android:text="@string/enter_correct_number"
                    android:drawablePadding="@dimen/_4dp"
                    android:drawableStart="@drawable/ic_error_info_circle"
                    android:layout_marginStart="@dimen/_12dp"
                    android:layout_marginEnd="@dimen/_12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@id/clRechargePanel"
                    app:layout_constraintTop_toBottomOf="@id/clRechargePanel"
                    app:layout_constraintVertical_bias="0.0" />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@id/clLoan"
                    android:visibility="gone"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8dp"
                    android:layout_marginStart="@dimen/_12dp"
                    android:layout_marginEnd="@dimen/_12dp"
                    app:layout_constraintBottom_toTopOf="@id/clLoan"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvMsisdnErrorMessage">
                    <include
                        android:id="@id/loanWarningLayout"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        layout="@layout/item_loan_warning" />
                    <include
                        android:id="@id/loanAddedLayout"
                        android:visibility="gone"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        layout="@layout/item_loan_added" />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@id/clOffer"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8dp"
                    android:layout_marginStart="@dimen/_8dp"
                    android:layout_marginEnd="@dimen/_8dp"
                    app:layout_constraintBottom_toTopOf="@id/btnGStore"
                    app:layout_constraintTop_toBottomOf="@id/clLoan">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_color_medium"
                        android:gravity="center_horizontal"
                        android:id="@id/txtResult"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="G-Store Offers"
                        android:layout_marginStart="@dimen/_8dp"
                        app:layout_constraintEnd_toStartOf="@id/tvSeeMoreText"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_12sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:gravity="end|center"
                        android:id="@id/tvSeeMoreText"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/see_more"
                        android:drawablePadding="4.0dip"
                        android:layout_marginEnd="@dimen/_8dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/txtResult"
                        app:layout_constraintTop_toTopOf="parent" />
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@id/rvResults"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_8dp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        app:layout_constrainedHeight="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/txtResult"
                        app:layout_constraintVertical_bias="0.0" />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.google.android.material.button.MaterialButton
                    android:enabled="false"
                    android:textSize="@dimen/_12sp"
                    android:id="@id/btnGStore"
                    android:padding="0.0dip"
                    android:layout_width="0.0dip"
                    android:layout_height="@dimen/_36dp"
                    android:layout_marginTop="@dimen/_16dp"
                    android:layout_marginBottom="@dimen/_16dp"
                    android:text="@string/g_store_tong"
                    android:insetTop="0.0dip"
                    android:insetBottom="0.0dip"
                    android:layout_marginStart="@dimen/_12dp"
                    app:cornerRadius="@dimen/_32dp"
                    app:layout_constraintEnd_toStartOf="@id/btnRecharge"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/clOffer"
                    style="@style/Button_Green_Only.RechargePanel" />
                <com.google.android.material.button.MaterialButton
                    android:enabled="false"
                    android:textSize="@dimen/_12sp"
                    android:id="@id/btnRecharge"
                    android:layout_width="0.0dip"
                    android:layout_height="@dimen/_36dp"
                    android:layout_marginTop="@dimen/_16dp"
                    android:text="@string/el_recharge"
                    android:insetTop="0.0dip"
                    android:insetBottom="0.0dip"
                    android:layout_marginStart="@dimen/_8dp"
                    android:layout_marginEnd="@dimen/_12dp"
                    app:cornerRadius="@dimen/_32dp"
                    app:layout_constraintBottom_toBottomOf="@id/btnGStore"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@id/btnGStore"
                    app:layout_constraintTop_toBottomOf="@id/clOffer"
                    app:layout_constraintVertical_bias="0.0"
                    style="@style/Button_Green_Only.RechargePanel" />
                <com.google.android.material.button.MaterialButton
                    android:enabled="false"
                    android:textSize="@dimen/_12sp"
                    android:id="@id/btnCard"
                    android:layout_width="0.0dip"
                    android:layout_height="@dimen/_36dp"
                    android:layout_marginTop="@dimen/_12dp"
                    android:layout_marginBottom="@dimen/_16dp"
                    android:text="@string/e_card"
                    android:insetTop="0.0dip"
                    android:insetBottom="0.0dip"
                    android:layout_marginStart="@dimen/_12dp"
                    app:cornerRadius="@dimen/_32dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnEasyPlan"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btnGStore"
                    style="@style/Button_Red_Border_Only.RechargePanel" />
                <com.google.android.material.button.MaterialButton
                    android:enabled="false"
                    android:textSize="@dimen/_12sp"
                    android:id="@id/btnEasyPlan"
                    android:layout_width="0.0dip"
                    android:layout_height="@dimen/_36dp"
                    android:layout_marginTop="@dimen/_12dp"
                    android:text="@string/easy_plan"
                    android:insetTop="0.0dip"
                    android:insetBottom="0.0dip"
                    android:layout_marginStart="@dimen/_8dp"
                    android:layout_marginEnd="@dimen/_12dp"
                    app:cornerRadius="@dimen/_32dp"
                    app:layout_constraintBottom_toBottomOf="@id/btnCard"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@id/btnCard"
                    app:layout_constraintTop_toBottomOf="@id/btnGStore"
                    style="@style/Button_Red_Border_Only.RechargePanel" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <View
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintVertical_bias="1.0" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
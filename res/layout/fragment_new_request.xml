<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:padding="@dimen/_16dp"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <TextView
        android:textSize="@dimen/_14sp"
        android:textStyle="bold"
        android:textColor="@color/black_800"
        android:gravity="center"
        android:id="@id/tvAddBIO"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_36dp"
        android:text="@string/click_below_to_add_new_biometric"
        app:layout_constraintBottom_toTopOf="@id/btnAddBiometric"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />
    <com.google.android.material.button.MaterialButton
        android:enabled="true"
        android:id="@id/btnAddBiometric"
        android:layout_width="0.0dip"
        android:layout_height="@dimen/_50dp"
        android:layout_marginTop="@dimen/_16dp"
        android:layout_marginBottom="@dimen/_36dp"
        android:text="@string/add_biometric"
        android:insetTop="0.0dip"
        android:insetBottom="0.0dip"
        android:textAllCaps="false"
        android:paddingStart="@dimen/_12dp"
        android:paddingEnd="@dimen/_12dp"
        android:layout_marginStart="@dimen/_16dp"
        android:layout_marginEnd="@dimen/_16dp"
        app:cornerRadius="@dimen/_32dp"
        app:icon="@drawable/ic_biometric"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/_6dp"
        app:iconTint="@color/text_color_red_grey_recharge_panel"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Button_Red_Border_Only.RechargePanel" />
</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ScrollView
        android:id="@id/svAddress"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        app:layout_constraintBottom_toTopOf="@id/clRechargeButton"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="@dimen/_12dp"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@id/guidelineStartMargin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_begin="@dimen/_16dp" />
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@id/guidelineEndMargin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_end="@dimen/_16dp" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_14sp"
                android:textStyle="bold"
                android:textColor="@color/black_800"
                android:id="@id/tvCustomerInfo"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10dp"
                android:text="@string/find_your_grid"
                app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
                app:layout_constraintTop_toTopOf="parent" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_14sp"
                android:textColor="@color/black_800"
                android:gravity="start|center"
                android:id="@id/tvCluster"
                android:background="@drawable/text_field_background"
                android:padding="@dimen/_12dp"
                android:visibility="gone"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10dp"
                android:minHeight="@dimen/_44dp"
                android:text="Select cluster"
                android:drawablePadding="@dimen/_16dp"
                android:layout_weight="1.0"
                android:inputType="number"
                android:drawableEnd="@drawable/ic_arrow_down"
                app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
                app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
                app:layout_constraintTop_toBottomOf="@id/tvCustomerInfo" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_14sp"
                android:textColor="@color/black_800"
                android:gravity="start|center"
                android:id="@id/tvRegion"
                android:background="@drawable/text_field_background"
                android:padding="@dimen/_12dp"
                android:visibility="gone"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10dp"
                android:minHeight="@dimen/_44dp"
                android:text="Select region"
                android:drawablePadding="@dimen/_16dp"
                android:layout_weight="1.0"
                android:inputType="number"
                android:drawableEnd="@drawable/ic_arrow_down"
                app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
                app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
                app:layout_constraintTop_toBottomOf="@id/tvCluster" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_14sp"
                android:textColor="@color/black_800"
                android:gravity="start|center"
                android:id="@id/tvArea"
                android:background="@drawable/text_field_background"
                android:padding="@dimen/_12dp"
                android:visibility="gone"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10dp"
                android:minHeight="@dimen/_44dp"
                android:text="Select area"
                android:drawablePadding="@dimen/_16dp"
                android:layout_weight="1.0"
                android:inputType="number"
                android:drawableEnd="@drawable/ic_arrow_down"
                app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
                app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
                app:layout_constraintTop_toBottomOf="@id/tvRegion" />
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@id/llThana"
                android:background="@drawable/bg_thana"
                android:paddingLeft="@dimen/_12dp"
                android:paddingTop="@dimen/_4dp"
                android:paddingRight="@dimen/_12dp"
                android:paddingBottom="@dimen/_8dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10dp"
                android:foreground="?selectableItemBackground"
                android:minHeight="@dimen/_60dp"
                android:paddingHorizontal="@dimen/_12dp"
                app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
                app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
                app:layout_constraintTop_toBottomOf="@id/tvArea">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_10sp"
                    android:textColor="@color/black_800"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thana" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_14sp"
                    android:textColor="@color/black_800"
                    android:gravity="start|center"
                    android:id="@id/tvThana"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:clickable="false"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4dp"
                    android:text="Select Thana"
                    android:drawablePadding="@dimen/_16dp"
                    android:drawableEnd="@drawable/ic_arrow_down"
                    app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
                    app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
                    app:layout_constraintTop_toBottomOf="@id/tvThana" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@id/llUnion"
                android:background="@drawable/bg_thana"
                android:paddingLeft="@dimen/_12dp"
                android:paddingTop="@dimen/_4dp"
                android:paddingRight="@dimen/_12dp"
                android:paddingBottom="@dimen/_8dp"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10dp"
                android:minHeight="@dimen/_60dp"
                android:paddingHorizontal="@dimen/_12dp"
                app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
                app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
                app:layout_constraintTop_toBottomOf="@id/llThana">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_10sp"
                    android:textColor="@color/black_800"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Union" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_14sp"
                    android:textColor="@color/black_800"
                    android:gravity="start|center"
                    android:id="@id/tvUnion"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:clickable="false"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4dp"
                    android:text="Select Union"
                    android:drawablePadding="@dimen/_16dp"
                    android:drawableEnd="@drawable/ic_arrow_down"
                    app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
                    app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
                    app:layout_constraintTop_toBottomOf="@id/tvThana" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@id/llLandmarkType"
                android:background="@drawable/bg_landmark"
                android:paddingLeft="@dimen/_12dp"
                android:paddingTop="@dimen/_4dp"
                android:paddingRight="@dimen/_12dp"
                android:paddingBottom="@dimen/_8dp"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10dp"
                android:minHeight="@dimen/_60dp"
                android:paddingHorizontal="@dimen/_12dp"
                app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
                app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
                app:layout_constraintTop_toBottomOf="@id/llUnion">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_10sp"
                    android:textColor="@color/black_800"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Landmark" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_14sp"
                    android:textColor="@color/black_800"
                    android:gravity="start|center"
                    android:id="@id/tvLandmarkType"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:clickable="false"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4dp"
                    android:text="Select landmark type"
                    android:drawablePadding="@dimen/_16dp"
                    android:drawableEnd="@drawable/ic_arrow_down"
                    app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
                    app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
                    app:layout_constraintTop_toBottomOf="@id/tvThana" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@id/llLandmark"
                android:background="@drawable/bg_landmark"
                android:paddingLeft="@dimen/_12dp"
                android:paddingTop="@dimen/_4dp"
                android:paddingRight="@dimen/_12dp"
                android:paddingBottom="@dimen/_8dp"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10dp"
                android:minHeight="@dimen/_60dp"
                android:paddingHorizontal="@dimen/_12dp"
                app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
                app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
                app:layout_constraintTop_toBottomOf="@id/llLandmarkType">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_10sp"
                    android:textColor="@color/black_800"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Landmark" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_14sp"
                    android:textColor="@color/black_800"
                    android:gravity="start|center"
                    android:id="@id/tvLandmark"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:clickable="false"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4dp"
                    android:text="Select landmark"
                    android:drawablePadding="@dimen/_16dp"
                    android:drawableEnd="@drawable/ic_arrow_down"
                    app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
                    app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
                    app:layout_constraintTop_toBottomOf="@id/tvThana" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/clRechargeButton"
        android:background="@drawable/bg_recharge_bottom_btn"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:elevation="@dimen/_8dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.google.android.material.button.MaterialButton
            android:id="@id/btnRecharge"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/_48dp"
            android:layout_marginLeft="@dimen/_16dp"
            android:layout_marginTop="@dimen/_16dp"
            android:layout_marginRight="@dimen/_16dp"
            android:text="@string/text_search_hint"
            android:layout_weight="1.0"
            android:insetTop="0.0dip"
            android:insetBottom="0.0dip"
            android:textAllCaps="false"
            android:layout_marginHorizontal="@dimen/_16dp"
            app:cornerRadius="@dimen/_32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Button_Red_Body.RechargePanel" />
        <com.google.android.material.button.MaterialButton
            android:gravity="center"
            android:id="@id/btnLocateMe"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/_48dp"
            android:layout_marginLeft="@dimen/_16dp"
            android:layout_marginTop="@dimen/_10dp"
            android:layout_marginRight="@dimen/_16dp"
            android:layout_marginBottom="@dimen/_36dp"
            android:text="@string/locate_me"
            android:layout_weight="1.0"
            android:insetTop="0.0dip"
            android:insetBottom="0.0dip"
            android:textAllCaps="false"
            android:layout_marginHorizontal="@dimen/_16dp"
            app:cornerRadius="@dimen/_32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/Button_Red_Border_Only.RechargePanel" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
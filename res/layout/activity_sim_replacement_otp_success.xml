<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/main"
    android:background="@color/base_background"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@id/guidelineStartMargin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/_16dp" />
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@id/guidelineEndMargin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/_16dp" />
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/_14sp"
        android:textStyle="bold"
        android:textColor="@color/black_800"
        android:id="@id/tvEnterMobile"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_16dp"
        android:text="@string/kcp_number"
        app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
        app:layout_constraintTop_toTopOf="parent" />
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="16.0sp"
        android:textColor="@color/black_800"
        android:id="@id/tilName"
        android:background="@drawable/bg_rectangle_shape"
        android:padding="12.0dip"
        android:layout_width="0.0dip"
        android:layout_height="52.0dip"
        android:layout_marginTop="@dimen/_12dp"
        android:hint="01XXX"
        android:maxLength="11"
        android:drawablePadding="@dimen/_2dp"
        android:inputType="number"
        android:drawableStart="@drawable/ic_mobile"
        app:hintTextAppearance="@style/CustomHintText"
        app:hintTextColor="@color/black_500"
        app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
        app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
        app:layout_constraintTop_toBottomOf="@id/tvEnterMobile" />
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="16.0sp"
        android:textColor="@color/black_800"
        android:id="@id/tilKCPTwoNumber"
        android:background="@drawable/bg_rectangle_shape"
        android:padding="12.0dip"
        android:layout_width="0.0dip"
        android:layout_height="52.0dip"
        android:layout_marginTop="@dimen/_12dp"
        android:hint="01XXX"
        android:maxLength="11"
        android:drawablePadding="@dimen/_2dp"
        android:inputType="number"
        android:drawableStart="@drawable/ic_mobile"
        app:hintTextAppearance="@style/CustomHintText"
        app:hintTextColor="@color/black_500"
        app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
        app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
        app:layout_constraintTop_toBottomOf="@id/tilName" />
    <androidx.constraintlayout.widget.Group
        android:id="@id/groupSearchResults"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        app:constraint_referenced_ids="clSearchResults" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/clSearchResults"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_marginTop="@dimen/_16dp"
        android:layout_marginBottom="@dimen/_16dp"
        android:layout_marginStart="@dimen/_16dp"
        android:layout_marginEnd="@dimen/_16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tilKCPTwoNumber">
        <androidx.cardview.widget.CardView
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_4dp"
            app:cardCornerRadius="@dimen/_8dp"
            app:cardElevation="@dimen/_2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@id/clMiddle"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.constraintlayout.widget.Group
                    android:id="@id/groupOtpInfo"
                    android:visibility="gone"
                    android:layout_width="0.0dip"
                    android:layout_height="0.0dip"
                    app:constraint_referenced_ids="ivSuccess, txtAvailableNumber" />
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@id/ivSuccess"
                    android:layout_width="62.0dip"
                    android:layout_height="62.0dip"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_success_animation" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_26sp"
                    android:textStyle="bold"
                    android:textColor="@color/black_800"
                    android:gravity="center_horizontal"
                    android:id="@id/txtAvailableNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_16dp"
                    android:text="OTP has been sent 018XXXXXXXXXX, please contact to collect this OTP"
                    android:layout_marginStart="@dimen/_8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ivSuccess" />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@id/clHasOTPButton"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_24dp"
                    android:layout_marginStart="@dimen/_20dp"
                    android:layout_marginEnd="@dimen/_20dp"
                    android:elevation="@dimen/_8dp"
                    app:layout_constrainedHeight="true"
                    app:layout_constraintTop_toBottomOf="@id/txtAvailableNumber"
                    app:layout_constraintVertical_bias="1.0">
                    <com.google.android.material.button.MaterialButton
                        android:enabled="true"
                        android:id="@id/btnProceed"
                        android:layout_width="0.0dip"
                        android:layout_height="@dimen/_48dp"
                        android:layout_marginBottom="@dimen/_12dp"
                        android:text="@string/has_otp_replacement"
                        android:insetLeft="@dimen/_0dp"
                        android:insetRight="@dimen/_0dp"
                        android:insetTop="@dimen/_0dp"
                        android:insetBottom="@dimen/_0dp"
                        android:textAllCaps="false"
                        app:cornerRadius="@dimen/_32dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/Button_Red_Body.RechargePanel" />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@id/clRegenarteOTP"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_24dp"
                    android:layout_marginStart="@dimen/_20dp"
                    android:layout_marginEnd="@dimen/_20dp"
                    android:elevation="@dimen/_8dp"
                    app:layout_constrainedHeight="true"
                    app:layout_constraintTop_toBottomOf="@id/clHasOTPButton"
                    app:layout_constraintVertical_bias="1.0">
                    <com.google.android.material.button.MaterialButton
                        android:enabled="true"
                        android:id="@id/btnRegenarteOTP"
                        android:layout_width="0.0dip"
                        android:layout_height="@dimen/_48dp"
                        android:layout_marginBottom="@dimen/_12dp"
                        android:text="@string/regenerate_otp"
                        android:insetLeft="@dimen/_0dp"
                        android:insetRight="@dimen/_0dp"
                        android:insetTop="@dimen/_0dp"
                        android:insetBottom="@dimen/_0dp"
                        android:textAllCaps="false"
                        app:cornerRadius="@dimen/_32dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/Button_Red_Border_Only.RechargePanel" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/black_500"
        android:gravity="center"
        android:id="@id/btnRecharge"
        android:layout_width="0.0dip"
        android:layout_height="@dimen/_48dp"
        android:layout_marginTop="@dimen/_12dp"
        android:layout_marginBottom="@dimen/_20dp"
        android:text="@string/btn_return_to_home_text"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/_16dp"
        android:layout_marginEnd="@dimen/_16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
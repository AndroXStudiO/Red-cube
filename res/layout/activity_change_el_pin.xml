<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:fillViewport="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/base_background"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@id/guidelineStartMargin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="@dimen/_16dp" />
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@id/guidelineEndMargin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="@dimen/_16dp" />
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@id/guidelineTopMargin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.05" />
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@id/guidelineTop_60_Margin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.6" />
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@id/guideline_25_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.25" />
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@id/guideline_75_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.8" />
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_14sp"
            android:textStyle="bold"
            android:textColor="@color/black_800"
            android:id="@id/tvNewOperator"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_22dp"
            android:text="@string/change_pin_for"
            app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
            app:layout_constraintTop_toTopOf="parent" />
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/llNewOperator"
            android:layout_width="0.0dip"
            android:layout_height="@dimen/_56dp"
            android:layout_marginTop="@dimen/_12dp"
            app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
            app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
            app:layout_constraintTop_toBottomOf="@id/tvNewOperator">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_weight="1.0"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.cardview.widget.CardView
                    android:id="@id/clOperatorRobiSim"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_4dp"
                    android:layout_weight="1.0"
                    app:cardCornerRadius="@dimen/_8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:layout_weight="1.0"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:textColor="@color/black"
                            android:id="@id/ivRobiLogo"
                            android:layout_width="wrap_content"
                            android:layout_height="28.0dip"
                            android:layout_marginTop="@dimen/_12dp"
                            android:layout_marginBottom="@dimen/_12dp"
                            android:layout_marginStart="@dimen/_10dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@drawable/ic_operator_robi" />
                        <androidx.appcompat.widget.AppCompatImageView
                            android:textColor="@color/black"
                            android:id="@id/ivRobiCheck"
                            android:layout_width="@dimen/_24dp"
                            android:layout_height="@dimen/_24dp"
                            android:layout_margin="@dimen/_8dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@drawable/ic_unchecked_gray_border" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_weight="1.0"
                android:layout_marginStart="@dimen/_12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.cardview.widget.CardView
                    android:id="@id/clOperatorAirtelSim"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_4dp"
                    android:layout_weight="1.0"
                    app:cardCornerRadius="@dimen/_8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:layout_weight="1.0"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:textColor="@color/black"
                            android:id="@id/ivAirtelLogo"
                            android:layout_width="wrap_content"
                            android:layout_height="28.0dip"
                            android:layout_marginTop="@dimen/_12dp"
                            android:layout_marginBottom="@dimen/_12dp"
                            android:scaleType="fitStart"
                            android:adjustViewBounds="true"
                            android:layout_marginStart="@dimen/_10dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@drawable/ic_operator_airtel" />
                        <androidx.appcompat.widget.AppCompatImageView
                            android:textColor="@color/black"
                            android:id="@id/ivAirtelCheck"
                            android:layout_width="@dimen/_24dp"
                            android:layout_height="@dimen/_24dp"
                            android:layout_margin="@dimen/_8dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@drawable/ic_unchecked_gray_border" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@id/passwordInputLayout"
            android:background="@drawable/text_field_background"
            android:visibility="visible"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/_56dp"
            android:layout_marginLeft="@dimen/_16dp"
            android:layout_marginTop="@dimen/_10dp"
            android:layout_marginRight="@dimen/_16dp"
            android:hint="@string/enter_pin"
            app:boxBackgroundColor="@android:color/transparent"
            app:boxCollapsedPaddingTop="4.0dip"
            app:boxStrokeWidth="0.0dip"
            app:boxStrokeWidthFocused="0.0dip"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/black"
            app:hintTextAppearance="@style/CustomHintText"
            app:hintTextColor="@color/black_500"
            app:layout_constraintTop_toBottomOf="@id/llNewOperator">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@id/editTextPassword"
                android:background="@android:color/transparent"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:maxLength="4"
                android:inputType="numberPassword" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@id/confirmPasswordInputLayout"
            android:background="@drawable/text_field_background"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/_56dp"
            android:layout_marginLeft="@dimen/_16dp"
            android:layout_marginTop="@dimen/_12dp"
            android:layout_marginRight="@dimen/_16dp"
            android:hint="@string/enter_confirm_pin"
            app:boxBackgroundColor="@android:color/transparent"
            app:boxCollapsedPaddingTop="4.0dip"
            app:boxStrokeWidth="0.0dip"
            app:boxStrokeWidthFocused="0.0dip"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/black"
            app:hintTextAppearance="@style/CustomHintText"
            app:hintTextColor="@color/black_500"
            app:layout_constraintTop_toBottomOf="@id/passwordInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@id/editTextConfirmPassword"
                android:background="@android:color/transparent"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:maxLength="4"
                android:inputType="numberPassword" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@id/confirmNewPasswordInputLayout"
            android:background="@drawable/text_field_background"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/_56dp"
            android:layout_marginLeft="@dimen/_16dp"
            android:layout_marginTop="@dimen/_12dp"
            android:layout_marginRight="@dimen/_16dp"
            android:hint="@string/enter_confirm_new_pin"
            app:boxBackgroundColor="@android:color/transparent"
            app:boxCollapsedPaddingTop="4.0dip"
            app:boxStrokeWidth="0.0dip"
            app:boxStrokeWidthFocused="0.0dip"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/black"
            app:hintTextAppearance="@style/CustomHintText"
            app:hintTextColor="@color/black_500"
            app:layout_constraintTop_toBottomOf="@id/confirmPasswordInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@id/editTextConfirmNewPassword"
                android:background="@android:color/transparent"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:maxLength="4"
                android:inputType="numberPassword" />
        </com.google.android.material.textfield.TextInputLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/clProceed"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_36dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintTop_toBottomOf="@id/confirmNewPasswordInputLayout"
            app:layout_constraintVertical_bias="1.0">
            <com.google.android.material.button.MaterialButton
                android:id="@id/btnSubmit"
                android:layout_width="0.0dip"
                android:layout_height="@dimen/_48dp"
                android:layout_marginTop="@dimen/_12dp"
                android:layout_marginBottom="@dimen/_16dp"
                android:text="@string/btn_proceed"
                android:insetTop="@dimen/_0dp"
                android:insetBottom="@dimen/_0dp"
                android:textAllCaps="false"
                android:layout_marginStart="@dimen/_16dp"
                android:layout_marginEnd="@dimen/_16dp"
                app:cornerRadius="@dimen/_32dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Button_Red_Body.RechargePanel" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:background="@color/base_background"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/white"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_marginTop="@dimen/_10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.cardview.widget.CardView
            android:id="@id/cvSearchView"
            android:background="@color/white"
            android:layout_width="0.0dip"
            android:layout_height="@dimen/_40dp"
            android:layout_marginTop="@dimen/_12dp"
            android:layout_marginStart="@dimen/_16dp"
            android:layout_marginEnd="@dimen/_16dp"
            app:cardCornerRadius="@dimen/_8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@id/ivSearch"
                    android:layout_width="18.0dip"
                    android:layout_height="18.0dip"
                    android:layout_marginStart="@dimen/_12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_search" />
                <androidx.appcompat.widget.AppCompatEditText
                    android:textSize="@dimen/_14sp"
                    android:textColorHint="@color/light_grey"
                    android:id="@id/etSearch"
                    android:background="@null"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:hint="Search by number"
                    android:inputType="number"
                    android:imeOptions="actionNext"
                    android:nextFocusForward="@id/etAmount"
                    android:paddingStart="@dimen/_4dp"
                    android:paddingEnd="@dimen/_4dp"
                    android:layout_marginStart="@dimen/_8dp"
                    android:layout_marginEnd="@dimen/_8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ivSearch"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/clMiddle"
            android:background="@drawable/bg_rectangle_shape_with_below_zero_radius"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10dp"
            android:layout_marginStart="@dimen/_16dp"
            android:layout_marginEnd="@dimen/_16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cvSearchView">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/llHeaderBrandEl"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10dp"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_11sp"
                    android:textColor="@color/black_500"
                    android:gravity="center"
                    android:id="@id/textName"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:text="Order"
                    android:layout_weight="0.5" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_11sp"
                    android:textColor="@color/black_500"
                    android:gravity="center"
                    android:id="@id/textUPrice"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:text="SIM Serial"
                    android:layout_weight="1.0" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_11sp"
                    android:textColor="@color/black_500"
                    android:gravity="center"
                    android:id="@id/textQty"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:text="Number"
                    android:layout_weight="1.0" />
                <FrameLayout
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_gravity="center"
                        android:id="@id/ivCopy"
                        android:visibility="invisible"
                        android:layout_width="@dimen/_16dp"
                        android:layout_height="@dimen/_16dp" />
                </FrameLayout>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:gravity="center"
                android:id="@id/recycleView"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:layout_marginTop="@dimen/_10dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintEnd_toStartOf="@id/guidelineEndMargin"
                app:layout_constraintStart_toEndOf="@id/guidelineStartMargin"
                app:layout_constraintTop_toBottomOf="@id/llHeaderBrandEl" />
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@id/guidelineStartMargin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_begin="@dimen/_16dp" />
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@id/guidelineEndMargin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_end="@dimen/_16dp" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
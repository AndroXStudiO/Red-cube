<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.card.MaterialCardView
        android:id="@id/cvHeaderFilter"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10dp"
        android:layout_marginStart="@dimen/_16dp"
        android:layout_marginEnd="@dimen/_16dp"
        app:cardElevation="@dimen/_4dp"
        app:cardPreventCornerOverlap="false"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/BottomCornerCard">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center"
            android:paddingTop="@dimen/_11dp"
            android:paddingBottom="@dimen/_16dp"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/_12dp"
            android:paddingEnd="@dimen/_12dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@id/ivOrderIdImg"
                android:layout_width="@dimen/_18dp"
                android:layout_height="@dimen/_18dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_customer_profile"
                app:tint="@color/black_500" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_12sp"
                android:textColor="@color/black_500"
                android:id="@id/tvOrderIdHolder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Order ID"
                android:layout_marginStart="@dimen/_8dp"
                app:layout_constraintStart_toEndOf="@id/ivOrderIdImg"
                app:layout_constraintTop_toTopOf="@id/ivOrderIdImg" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_14sp"
                android:textStyle="bold"
                android:textColor="@color/black_800"
                android:id="@id/tvOrderId"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4dp"
                android:layout_marginStart="@dimen/_8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivOrderIdImg"
                app:layout_constraintTop_toBottomOf="@id/tvOrderIdHolder" />
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@id/ivCustomerImg"
                android:layout_width="@dimen/_18dp"
                android:layout_height="@dimen/_18dp"
                android:layout_marginTop="@dimen/_12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvOrderId"
                app:srcCompat="@drawable/ic_customer_profile"
                app:tint="@color/black_500" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_12sp"
                android:textColor="@color/black_500"
                android:id="@id/tvCustomerNameHolder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/customer_name"
                android:layout_marginStart="@dimen/_8dp"
                app:layout_constraintStart_toEndOf="@id/ivCustomerImg"
                app:layout_constraintTop_toTopOf="@id/ivCustomerImg" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_14sp"
                android:textStyle="bold"
                android:textColor="@color/black_800"
                android:id="@id/tvCustomerName"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4dp"
                android:layout_marginStart="@dimen/_8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivCustomerImg"
                app:layout_constraintTop_toBottomOf="@id/tvCustomerNameHolder" />
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@id/ivAddressImg"
                android:layout_width="@dimen/_18dp"
                android:layout_height="@dimen/_18dp"
                android:layout_marginTop="@dimen/_12dp"
                android:scaleType="centerCrop"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvCustomerName"
                app:srcCompat="@drawable/ic_location"
                app:tint="@color/black_500" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_12sp"
                android:textColor="@color/black_500"
                android:id="@id/tvAddressHolder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/address"
                android:layout_marginStart="@dimen/_8dp"
                app:layout_constraintStart_toEndOf="@id/ivAddressImg"
                app:layout_constraintTop_toTopOf="@id/ivAddressImg" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_14sp"
                android:textStyle="bold"
                android:textColor="@color/black_800"
                android:id="@id/tvAddress"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4dp"
                android:layout_marginStart="@dimen/_8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivAddressImg"
                app:layout_constraintTop_toBottomOf="@id/tvAddressHolder" />
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@id/ivContactImg"
                android:layout_width="@dimen/_18dp"
                android:layout_height="@dimen/_18dp"
                android:layout_marginTop="@dimen/_12dp"
                android:scaleType="centerCrop"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvAddress"
                app:srcCompat="@drawable/ic_contact_call"
                app:tint="@color/black_500" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_12sp"
                android:textColor="@color/black_500"
                android:id="@id/tvContactNumberHolder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/contact_number"
                android:layout_marginStart="@dimen/_8dp"
                app:layout_constraintStart_toEndOf="@id/ivContactImg"
                app:layout_constraintTop_toTopOf="@id/ivContactImg" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_14sp"
                android:textStyle="bold"
                android:textColor="@color/black_800"
                android:id="@id/tvContactNumber"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4dp"
                android:layout_marginStart="@dimen/_8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivContactImg"
                app:layout_constraintTop_toBottomOf="@id/tvContactNumberHolder" />
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@id/ivNidImg"
                android:layout_width="@dimen/_18dp"
                android:layout_height="@dimen/_18dp"
                android:layout_marginTop="@dimen/_12dp"
                android:scaleType="centerCrop"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvContactNumber"
                app:srcCompat="@drawable/ic_nid_uberization"
                app:tint="@color/black_500" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_12sp"
                android:textColor="@color/black_500"
                android:id="@id/tvNidHolder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nid"
                android:layout_marginStart="@dimen/_8dp"
                app:layout_constraintStart_toEndOf="@id/ivNidImg"
                app:layout_constraintTop_toTopOf="@id/ivNidImg" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_14sp"
                android:textStyle="bold"
                android:textColor="@color/black_800"
                android:id="@id/tvNid"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4dp"
                android:layout_marginStart="@dimen/_8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivNidImg"
                app:layout_constraintTop_toBottomOf="@id/tvNidHolder" />
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@id/ivExpectedDeliveryImg"
                android:layout_width="@dimen/_18dp"
                android:layout_height="@dimen/_18dp"
                android:layout_marginTop="@dimen/_12dp"
                android:scaleType="centerCrop"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvNid"
                app:srcCompat="@drawable/ic_location"
                app:tint="@color/black_500" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_12sp"
                android:textColor="@color/black_500"
                android:id="@id/tvExpectedDeliveryHolder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/expected_delivery_time"
                android:layout_marginStart="@dimen/_8dp"
                app:layout_constraintStart_toEndOf="@id/ivExpectedDeliveryImg"
                app:layout_constraintTop_toTopOf="@id/ivExpectedDeliveryImg" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_14sp"
                android:textStyle="bold"
                android:textColor="@color/black_800"
                android:id="@id/tvExpectedDelivery"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4dp"
                android:layout_marginStart="@dimen/_8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivExpectedDeliveryImg"
                app:layout_constraintTop_toBottomOf="@id/tvExpectedDeliveryHolder" />
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@id/ivDistanceImg"
                android:layout_width="@dimen/_18dp"
                android:layout_height="@dimen/_18dp"
                android:layout_marginTop="@dimen/_12dp"
                android:scaleType="centerCrop"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvExpectedDelivery"
                app:srcCompat="@drawable/ic_location"
                app:tint="@color/black_500" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_12sp"
                android:textColor="@color/black_500"
                android:id="@id/tvDistanceHolder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/distance"
                android:layout_marginStart="@dimen/_8dp"
                app:layout_constraintStart_toEndOf="@id/ivDistanceImg"
                app:layout_constraintTop_toTopOf="@id/ivDistanceImg" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_14sp"
                android:textStyle="bold"
                android:textColor="@color/black_800"
                android:id="@id/tvDistance"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4dp"
                android:layout_marginStart="@dimen/_8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivDistanceImg"
                app:layout_constraintTop_toBottomOf="@id/tvDistanceHolder" />
            <com.google.android.material.button.MaterialButton
                android:textSize="@dimen/_14sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:id="@id/btnCall"
                android:layout_width="0.0dip"
                android:layout_height="@dimen/_40dp"
                android:layout_marginTop="@dimen/_20dp"
                android:minHeight="40.0dip"
                android:text="@string/title_call"
                android:insetTop="0.0dip"
                android:insetBottom="0.0dip"
                android:textAllCaps="false"
                android:layout_marginEnd="@dimen/_6dp"
                app:cornerRadius="24.0dip"
                app:icon="@drawable/ic_call"
                app:iconGravity="textStart"
                app:layout_constraintEnd_toStartOf="@id/btnReassign"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvDistance"
                style="@style/Button_Red_Body.RechargePanel" />
            <com.google.android.material.button.MaterialButton
                android:textSize="@dimen/_14sp"
                android:textStyle="bold"
                android:id="@id/btnReassign"
                android:layout_width="0.0dip"
                android:layout_height="@dimen/_40dp"
                android:layout_marginTop="@dimen/_20dp"
                android:minHeight="40.0dip"
                android:text="@string/reassign"
                android:insetTop="0.0dip"
                android:insetBottom="0.0dip"
                android:textAllCaps="false"
                android:layout_marginStart="@dimen/_6dp"
                app:cornerRadius="24.0dip"
                app:icon="@drawable/ic_reassign"
                app:iconGravity="textStart"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/btnCall"
                app:layout_constraintTop_toBottomOf="@id/tvDistance"
                style="@style/Button_Red_Body.RechargePanel" />
            <com.google.android.material.button.MaterialButton
                android:textSize="@dimen/_14sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:id="@id/btnDirection"
                android:layout_width="0.0dip"
                android:layout_height="@dimen/_40dp"
                android:layout_marginTop="@dimen/_12dp"
                android:minHeight="40.0dip"
                android:text="@string/btn_direction"
                android:insetTop="0.0dip"
                android:insetBottom="0.0dip"
                android:textAllCaps="false"
                android:layout_marginEnd="@dimen/_6dp"
                app:cornerRadius="24.0dip"
                app:icon="@drawable/ic_direction"
                app:iconGravity="textStart"
                app:layout_constraintEnd_toStartOf="@id/btnChat"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnCall"
                style="@style/Button_Red_Body.RechargePanel" />
            <com.google.android.material.button.MaterialButton
                android:textSize="@dimen/_14sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:id="@id/btnChat"
                android:layout_width="0.0dip"
                android:layout_height="@dimen/_40dp"
                android:layout_marginTop="@dimen/_12dp"
                android:minHeight="40.0dip"
                android:text="@string/title_sms"
                android:insetTop="0.0dip"
                android:insetBottom="0.0dip"
                android:textAllCaps="false"
                android:layout_marginStart="@dimen/_6dp"
                app:cornerRadius="24.0dip"
                app:icon="@drawable/ic_sms"
                app:iconGravity="textStart"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/btnDirection"
                app:layout_constraintTop_toBottomOf="@id/btnCall"
                style="@style/Button_Red_Body.RechargePanel" />
            <com.google.android.material.button.MaterialButton
                android:textSize="@dimen/_14sp"
                android:textStyle="bold"
                android:id="@id/btnCancel"
                android:layout_width="0.0dip"
                android:layout_height="@dimen/_40dp"
                android:layout_marginTop="@dimen/_12dp"
                android:minHeight="40.0dip"
                android:text="Cancel"
                android:insetTop="0.0dip"
                android:insetBottom="0.0dip"
                android:textAllCaps="false"
                app:cornerRadius="24.0dip"
                app:iconGravity="textStart"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnChat"
                style="@style/Button_Red_Body.RechargePanel" />
            <com.google.android.material.button.MaterialButton
                android:textSize="@dimen/_14sp"
                android:textStyle="bold"
                android:id="@id/btnFullfillment"
                android:layout_width="0.0dip"
                android:layout_height="@dimen/_48dp"
                android:layout_marginTop="@dimen/_20dp"
                android:minHeight="40.0dip"
                android:text="@string/btn_fullfillment"
                android:insetTop="0.0dip"
                android:insetBottom="0.0dip"
                android:textAllCaps="false"
                app:cornerRadius="24.0dip"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnCancel"
                style="@style/Button_Red_Body.RechargePanel" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
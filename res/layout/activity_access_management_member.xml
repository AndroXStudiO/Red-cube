<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ScrollView
        android:id="@id/svAddress"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        app:layout_constraintBottom_toTopOf="@id/clRechargeButton"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="@dimen/_12dp"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@id/guidelineStartMargin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_begin="@dimen/_16dp" />
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@id/guidelineEndMargin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_end="@dimen/_16dp" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_12sp"
                android:textStyle="normal"
                android:textColor="@color/black_800"
                android:id="@id/tvTitle"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8dp"
                android:text="@string/member_fillup_title"
                app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
                app:layout_constraintTop_toTopOf="parent" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_14sp"
                android:textStyle="bold"
                android:textColor="@color/black_800"
                android:id="@id/tvCustomerInfo"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16dp"
                android:text="@string/member_name"
                app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
                app:layout_constraintTop_toBottomOf="@id/tvTitle" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@id/tilName"
                android:background="@drawable/text_field_background"
                android:paddingTop="@dimen/_2dp"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12dp"
                android:minHeight="@dimen/_52dp"
                android:hint="@string/name"
                app:boxBackgroundColor="@android:color/transparent"
                app:boxCollapsedPaddingTop="@dimen/_4dp"
                app:boxStrokeWidth="0.0dip"
                app:boxStrokeWidthFocused="0.0dip"
                app:hintTextAppearance="@style/CustomHintText"
                app:hintTextColor="@color/black_500"
                app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
                app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
                app:layout_constraintTop_toBottomOf="@id/tvCustomerInfo">
                <com.google.android.material.textfield.TextInputEditText
                    android:textSize="@dimen/_14sp"
                    android:id="@id/etName"
                    android:background="@android:color/transparent"
                    android:paddingBottom="2.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:maxLength="50"
                    android:inputType="textPersonName" />
            </com.google.android.material.textfield.TextInputLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_14sp"
                android:textStyle="bold"
                android:textColor="@color/black_800"
                android:id="@id/tvContact"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16dp"
                android:text="@string/contact_number"
                app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
                app:layout_constraintTop_toBottomOf="@id/tilName" />
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="16.0sp"
                android:textColor="@color/black_800"
                android:id="@id/etContact"
                android:background="@drawable/bg_rectangle_shape"
                android:padding="12.0dip"
                android:layout_width="0.0dip"
                android:layout_height="52.0dip"
                android:layout_marginTop="@dimen/_12dp"
                android:hint="01XXX"
                android:maxLength="11"
                android:drawablePadding="@dimen/_2dp"
                android:inputType="number"
                android:drawableStart="@drawable/ic_mobile"
                app:hintTextAppearance="@style/CustomHintText"
                app:hintTextColor="@color/black_500"
                app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
                app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
                app:layout_constraintTop_toBottomOf="@id/tvContact" />
            <com.google.android.material.button.MaterialButton
                android:textSize="@dimen/_16sp"
                android:id="@id/btnGenOtp"
                android:layout_width="0.0dip"
                android:layout_height="@dimen/_48dp"
                android:layout_marginTop="@dimen/_40dp"
                android:text="@string/btn_generate_otp"
                android:layout_weight="1.0"
                android:insetTop="0.0dip"
                android:insetBottom="0.0dip"
                android:textAllCaps="false"
                app:cornerRadius="@dimen/_32dp"
                app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
                app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
                app:layout_constraintTop_toBottomOf="@id/clPhysicalSim"
                style="@style/Button_Red_Body.RechargePanel" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_14sp"
                android:textStyle="bold"
                android:textColor="@color/black_800"
                android:id="@id/tvOtp"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_28dp"
                android:text="@string/input_otp"
                app:layout_constraintEnd_toStartOf="@id/tvTimer"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
                app:layout_constraintTop_toBottomOf="@id/btnGenOtp" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_14sp"
                android:textStyle="bold"
                android:textColor="@color/black_800"
                android:id="@id/tvTimer"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_28dp"
                android:text=""
                app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintTop_toBottomOf="@id/btnGenOtp" />
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="16.0sp"
                android:textColor="@color/black_800"
                android:id="@id/etOtp"
                android:background="@drawable/bg_rectangle_shape"
                android:padding="12.0dip"
                android:layout_width="0.0dip"
                android:layout_height="52.0dip"
                android:layout_marginTop="@dimen/_12dp"
                android:hint="XXXXXX"
                android:maxLength="6"
                android:drawablePadding="@dimen/_2dp"
                android:inputType="number"
                android:drawableStart="@drawable/ic_mobile"
                app:hintTextAppearance="@style/CustomHintText"
                app:hintTextColor="@color/black_500"
                app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
                app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
                app:layout_constraintTop_toBottomOf="@id/tvOtp" />
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@id/clPhysicalSim"
                android:layout_width="0.0dip"
                android:layout_height="@dimen/_52dp"
                android:layout_marginTop="@dimen/_16dp"
                app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
                app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
                app:layout_constraintTop_toBottomOf="@id/etContact">
                <androidx.appcompat.widget.AppCompatImageView
                    android:textColor="@color/black"
                    android:id="@id/ivCheck"
                    android:layout_width="@dimen/_24dp"
                    android:layout_height="@dimen/_24dp"
                    android:layout_margin="@dimen/_8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_unchecked_gray_border" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_14sp"
                    android:textColor="@color/black_800"
                    android:id="@id/tvPhysicalSim"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/member_photo"
                    android:layout_marginStart="@dimen/_8dp"
                    android:layout_marginEnd="16.0dip"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ivCheck"
                    app:layout_constraintTop_toTopOf="parent" />
                <androidx.appcompat.widget.AppCompatImageView
                    android:textColor="@color/black"
                    android:id="@id/ivCheck1"
                    android:layout_width="@dimen/_24dp"
                    android:layout_height="@dimen/_24dp"
                    android:layout_margin="@dimen/_8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_unchecked_gray_border" />
                <com.google.android.material.button.MaterialButton
                    android:enabled="true"
                    android:textSize="@dimen/_14sp"
                    android:id="@id/btnScan"
                    android:layout_width="0.0dip"
                    android:layout_height="@dimen/_36dp"
                    android:text="@string/capture"
                    android:insetTop="0.0dip"
                    android:insetBottom="0.0dip"
                    android:textAllCaps="false"
                    android:paddingStart="@dimen/_12dp"
                    android:paddingEnd="@dimen/_12dp"
                    app:cornerRadius="@dimen/_42dp"
                    app:icon="@drawable/ic_camera"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/_4dp"
                    app:iconTint="@color/text_color_red_grey_recharge_panel"
                    app:layout_constrainedHeight="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Button_Red_Border_Only.RechargePanel" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/clRechargeButton"
        android:background="@drawable/bg_recharge_bottom_btn"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/svAddress"
        app:layout_constraintVertical_bias="1.0">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/black_500"
            android:gravity="center"
            android:id="@id/tvTC"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/_48dp"
            android:layout_margin="@dimen/_16dp"
            android:text="@string/by_proceeding_you_are_agreeing_to_our_terms_and_conditions"
            android:layout_weight="1.0"
            android:textAllCaps="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16dp"
            android:layout_marginBottom="@dimen/_16dp"
            android:layout_marginStart="@dimen/_16dp"
            android:layout_marginEnd="@dimen/_16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTC">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_16sp"
                android:textColor="@color/black_500"
                android:gravity="center"
                android:id="@id/btnBack"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/_48dp"
                android:layout_margin="@dimen/_2dp"
                android:text="@string/back"
                android:layout_weight="1.0"
                android:textAllCaps="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTC" />
            <com.google.android.material.button.MaterialButton
                android:textSize="@dimen/_16sp"
                android:id="@id/btnRecharge"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/_48dp"
                android:layout_margin="@dimen/_2dp"
                android:text="@string/next"
                android:layout_weight="1.0"
                android:insetTop="0.0dip"
                android:insetBottom="0.0dip"
                android:textAllCaps="false"
                app:cornerRadius="@dimen/_32dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTC"
                style="@style/Button_Red_Body.RechargePanel" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
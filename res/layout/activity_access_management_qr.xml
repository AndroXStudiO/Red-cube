<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/_14sp"
        android:textStyle="bold"
        android:textColor="@color/black_800"
        android:id="@id/tvValidity"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_24dp"
        android:text="Validity: "
        android:textAlignment="center"
        android:layout_marginStart="@dimen/_16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/_14sp"
        android:textStyle="bold"
        android:textColor="@color/black_800"
        android:id="@id/tvTime"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_24dp"
        android:text=""
        android:textAlignment="center"
        android:layout_marginStart="@dimen/_8dp"
        app:layout_constraintStart_toEndOf="@id/tvValidity"
        app:layout_constraintTop_toTopOf="parent" />
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@id/guideLineHorizontal70"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.65" />
    <androidx.cardview.widget.CardView
        android:id="@id/layoutSimSaleImage"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_marginTop="@dimen/_16dp"
        android:layout_marginStart="16.0dip"
        android:layout_marginEnd="16.0dip"
        android:elevation="10.0dip"
        app:cardCornerRadius="8.0dip"
        app:layout_constraintBottom_toTopOf="@id/guideLineHorizontal70"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvValidity">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@id/ivQR"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:scaleType="centerCrop"
            android:adjustViewBounds="false" />
    </androidx.cardview.widget.CardView>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/bg_recharge_bottom_btn"
        android:paddingLeft="@dimen/_16dp"
        android:paddingTop="@dimen/_24dp"
        android:paddingRight="@dimen/_16dp"
        android:paddingBottom="@dimen/_24dp"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/_16dp"
        android:paddingVertical="@dimen/_24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutSimSaleImage"
        app:layout_constraintVertical_bias="1.0">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_16sp"
            android:textColor="@color/black_500"
            android:gravity="center"
            android:id="@id/btnBack"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/_48dp"
            android:layout_margin="@dimen/_2dp"
            android:text="@string/back"
            android:layout_weight="1.0"
            android:textAllCaps="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTC" />
        <com.google.android.material.button.MaterialButton
            android:textSize="@dimen/_16sp"
            android:id="@id/btnNext"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/_48dp"
            android:layout_margin="@dimen/_2dp"
            android:text="@string/generate_again"
            android:layout_weight="1.0"
            android:insetTop="0.0dip"
            android:insetBottom="0.0dip"
            android:textAllCaps="false"
            app:cornerRadius="@dimen/_32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTC"
            style="@style/Button_Red_Body.RechargePanel" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
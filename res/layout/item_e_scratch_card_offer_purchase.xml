<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_8dp"
    app:cardCornerRadius="@dimen/_8dp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <FrameLayout
            android:id="@id/clImageBg"
            android:background="@drawable/bg_ecard_image"
            android:layout_width="0.0dip"
            android:layout_height="55.0dip"
            android:layout_margin="@dimen/_10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@id/ivCardBanner"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_margin="@dimen/_1dp"
                android:src="@drawable/e_card_img"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/Rounded8dp" />
        </FrameLayout>
        <bd.com.robi.redcube.custom_view.DottedArcView
            android:layout_width="@dimen/_12dp"
            android:layout_height="@dimen/_12dp"
            android:translationX="-6.0dip"
            app:arcColor="#ff9aa4b2"
            app:arcPosition="right"
            app:bodyColor="@color/white"
            app:dashGap="@dimen/_4dp"
            app:dashLength="@dimen/_4dp"
            app:layout_constraintBottom_toBottomOf="@id/clImageBg"
            app:layout_constraintStart_toStartOf="@id/clImageBg"
            app:layout_constraintTop_toTopOf="@id/clImageBg"
            app:strokeWidth="@dimen/_2dp" />
        <bd.com.robi.redcube.custom_view.DottedArcView
            android:layout_width="@dimen/_12dp"
            android:layout_height="@dimen/_12dp"
            android:translationX="6.0dip"
            app:arcColor="#ff9aa4b2"
            app:arcPosition="left"
            app:bodyColor="@color/white"
            app:dashGap="@dimen/_4dp"
            app:dashLength="@dimen/_4dp"
            app:layout_constraintBottom_toBottomOf="@id/clImageBg"
            app:layout_constraintEnd_toEndOf="@id/clImageBg"
            app:layout_constraintTop_toTopOf="@id/clImageBg"
            app:strokeWidth="@dimen/_2dp" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/_32dp"
            android:layout_marginTop="@dimen/_8dp"
            android:layout_marginBottom="@dimen/_10dp"
            android:layout_marginStart="@dimen/_10dp"
            android:layout_marginEnd="@dimen/_10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/clImageBg">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:layout_weight="0.8">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_12sp"
                    android:textStyle="bold"
                    android:textColor="@color/black_800"
                    android:id="@id/tvCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/ivRobiCommssion"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@id/ivRobiCommssion"
                    android:layout_width="@dimen/_14dp"
                    android:layout_height="@dimen/_14dp"
                    android:layout_marginStart="@dimen/_14dp"
                    android:layout_marginEnd="@dimen/_6dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tvComissionRobi"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_commission_offer" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_12sp"
                    android:textStyle="bold"
                    android:textColor="@color/green_600"
                    android:id="@id/tvComissionRobi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_4dp"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:layout_weight="2.2">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_12sp"
                    android:textStyle="bold"
                    android:textColor="@color/black_800"
                    android:id="@id/tvAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
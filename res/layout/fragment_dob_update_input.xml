<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@id/guidelineStartMargin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/_16dp" />
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@id/guidelineEndMargin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/_16dp" />
    <androidx.constraintlayout.widget.Group
        android:id="@id/groupMobileNumberInput"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        app:constraint_referenced_ids="tvEnterMobile, tilName" />
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/_14sp"
        android:textStyle="bold"
        android:textColor="@color/black_800"
        android:id="@id/tvEnterMobile"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_16dp"
        android:text="@string/text_customer_number"
        app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
        app:layout_constraintTop_toTopOf="parent" />
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="16.0sp"
        android:textColor="@color/black_800"
        android:id="@id/tilName"
        android:background="@drawable/bg_rectangle_shape"
        android:padding="12.0dip"
        android:layout_width="0.0dip"
        android:layout_height="52.0dip"
        android:layout_marginTop="@dimen/_12dp"
        android:hint="01XXX"
        android:maxLength="11"
        android:drawablePadding="@dimen/_2dp"
        android:inputType="number"
        android:drawableStart="@drawable/ic_mobile"
        app:hintTextAppearance="@style/CustomHintText"
        app:hintTextColor="@color/black_500"
        app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
        app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
        app:layout_constraintTop_toBottomOf="@id/tvEnterMobile" />
    <com.google.android.material.textfield.TextInputLayout
        android:id="@id/tilNid"
        android:background="@drawable/text_field_background"
        android:paddingTop="@dimen/_2dp"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10dp"
        android:minHeight="@dimen/_52dp"
        android:hint="@string/nid_number"
        app:boxBackgroundColor="@android:color/transparent"
        app:boxCollapsedPaddingTop="@dimen/_4dp"
        app:boxStrokeWidth="0.0dip"
        app:boxStrokeWidthFocused="0.0dip"
        app:hintTextAppearance="@style/CustomHintText"
        app:hintTextColor="@color/black_500"
        app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
        app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
        app:layout_constraintTop_toBottomOf="@id/tilName">
        <com.google.android.material.textfield.TextInputEditText
            android:textSize="@dimen/_14sp"
            android:id="@id/etNID"
            android:background="@android:color/transparent"
            android:paddingBottom="0.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:maxLength="17"
            android:inputType="number" />
    </com.google.android.material.textfield.TextInputLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/_14sp"
        android:textStyle="bold"
        android:textColor="@color/black_800"
        android:id="@id/tvDOB"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10dp"
        android:text="@string/input_new_date_of_birth"
        app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
        app:layout_constraintTop_toBottomOf="@id/tilNid" />
    <bd.com.robi.redcube.custom_view.CustomDateInput
        android:id="@id/llDob"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10dp"
        app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
        app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
        app:layout_constraintTop_toBottomOf="@id/tvDOB" />
    <androidx.constraintlayout.widget.Group
        android:id="@id/groupSimSelection"
        android:visibility="gone"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        app:constraint_referenced_ids=" tvTitle,clSimSelection" />
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/_14sp"
        android:textStyle="bold"
        android:textColor="@color/black_800"
        android:id="@id/tvTitle"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_22dp"
        android:text="Select SIM Type"
        app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
        app:layout_constraintTop_toTopOf="parent" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/clSimSelection"
        android:background="@drawable/bg_pin"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12dp"
        app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
        app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/clPhysicalSim"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/_52dp"
            android:layout_margin="@dimen/_4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:textColor="@color/black"
                android:id="@id/ivLogo"
                android:layout_width="@dimen/_24dp"
                android:layout_height="@dimen/_24dp"
                android:layout_margin="@dimen/_8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_physical_sim_selection" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_14sp"
                android:textStyle="bold"
                android:textColor="@color/black_800"
                android:id="@id/tvPhysicalSim"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/physical_sim"
                android:layout_marginStart="@dimen/_8dp"
                android:layout_marginEnd="16.0dip"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivLogo"
                app:layout_constraintTop_toTopOf="parent" />
            <androidx.appcompat.widget.AppCompatImageView
                android:textColor="@color/black"
                android:id="@id/ivCheck1"
                android:layout_width="@dimen/_24dp"
                android:layout_height="@dimen/_24dp"
                android:layout_margin="@dimen/_8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_unchecked_gray_border" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/clESim"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/_52dp"
            android:layout_margin="@dimen/_4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/clPhysicalSim">
            <androidx.appcompat.widget.AppCompatImageView
                android:textColor="@color/black"
                android:id="@id/ivLogoESIm"
                android:layout_width="@dimen/_24dp"
                android:layout_height="@dimen/_24dp"
                android:layout_margin="@dimen/_8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_esim_selection" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_14sp"
                android:textStyle="bold"
                android:textColor="@color/black_800"
                android:id="@id/tvESim"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/esim"
                android:layout_marginStart="@dimen/_8dp"
                android:layout_marginEnd="16.0dip"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivLogoESIm"
                app:layout_constraintTop_toTopOf="parent" />
            <androidx.appcompat.widget.AppCompatImageView
                android:textColor="@color/black"
                android:id="@id/ivCheck2"
                android:layout_width="@dimen/_24dp"
                android:layout_height="@dimen/_24dp"
                android:layout_margin="@dimen/_8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_unchecked_gray_border" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/clRechargeButton"
        android:background="@drawable/bg_recharge_bottom_btn"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/_8dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="1.0">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/black_500"
            android:gravity="center"
            android:id="@id/tvSeventinDigitNid"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/_48dp"
            android:layout_margin="@dimen/_16dp"
            android:text="@string/dob_update_info_one"
            android:layout_weight="1.0"
            android:textAllCaps="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/black_500"
            android:gravity="center"
            android:id="@id/tvTenDigitNid"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/_48dp"
            android:layout_margin="@dimen/_16dp"
            android:text="@string/dob_update_info_two"
            android:layout_weight="1.0"
            android:textAllCaps="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSeventinDigitNid" />
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/black_500"
            android:gravity="center"
            android:id="@id/tvTC"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/_48dp"
            android:layout_margin="@dimen/_16dp"
            android:text="@string/by_proceeding_you_are_agreeing_to_our_terms_and_conditions"
            android:layout_weight="1.0"
            android:textAllCaps="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTenDigitNid" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16dp"
            android:layout_marginBottom="@dimen/_16dp"
            android:layout_marginStart="@dimen/_16dp"
            android:layout_marginEnd="@dimen/_16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTC">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_16sp"
                android:textColor="@color/black_500"
                android:gravity="center"
                android:id="@id/btnBack"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/_48dp"
                android:layout_margin="@dimen/_2dp"
                android:text="@string/back"
                android:layout_weight="1.0"
                android:textAllCaps="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTC" />
            <com.google.android.material.button.MaterialButton
                android:textSize="@dimen/_16sp"
                android:id="@id/btnRecharge"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/_48dp"
                android:layout_margin="@dimen/_2dp"
                android:text="@string/update_etsaf"
                android:layout_weight="1.0"
                android:insetTop="0.0dip"
                android:insetBottom="0.0dip"
                android:textAllCaps="false"
                app:cornerRadius="@dimen/_32dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTC"
                style="@style/Button_Red_Body.RechargePanel" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
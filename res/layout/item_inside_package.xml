<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_12dp"
    app:cardCornerRadius="@dimen/_8dp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/multi_recharge_selected_offer"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/llTopRow"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_10dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_14sp"
                android:textStyle="bold"
                android:textColor="@color/black_900"
                android:layout_gravity="center_vertical"
                android:id="@id/tvNumber"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_14sp"
                android:textStyle="bold"
                android:textColor="@color/black_900"
                android:id="@id/tvBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <View
            android:id="@id/view1"
            android:background="@color/black_200"
            android:visibility="visible"
            android:layout_width="fill_parent"
            android:layout_height="1.0dip"
            android:layout_marginStart="@dimen/_10dp"
            android:layout_marginEnd="@dimen/_10dp" />
        <androidx.cardview.widget.CardView
            android:id="@id/cvPackageDetails"
            android:visibility="visible"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_10dp"
            app:cardCornerRadius="@dimen/_8dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@id/clNumberInfo"
                android:background="@color/white"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/_40dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@id/ivOperator"
                    android:layout_width="20.0dip"
                    android:layout_height="20.0dip"
                    android:scaleType="centerInside"
                    android:layout_marginStart="@dimen/_8dp"
                    android:layout_marginEnd="@dimen/_8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_package_name" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_12sp"
                    android:textStyle="normal"
                    android:textColor="@color/black_800"
                    android:id="@id/tvPackageName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8dp"
                    app:layout_constraintBottom_toBottomOf="@id/ivOperator"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toEndOf="@id/ivOperator"
                    app:layout_constraintTop_toTopOf="@id/ivOperator" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</androidx.cardview.widget.CardView>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:background="@drawable/bg_stock_background_robi"
    android:layout_width="fill_parent"
    android:layout_height="80.0dip"
    android:layout_margin="@dimen/_6dp"
    app:cardCornerRadius="16.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@id/guidelineStartMargin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.25" />
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@id/guidelineVerticalMiddleMargin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.7" />
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@id/guidelineMiddleMargin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.5" />
        <ImageView
            android:id="@id/img_robi_logo"
            android:layout_width="20.0dip"
            android:layout_height="20.0dip"
            android:src="@drawable/ic_brand_robi"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <View
            android:id="@id/red_dot"
            android:background="@drawable/red_dot_circle"
            android:layout_width="6.0dip"
            android:layout_height="6.0dip"
            android:layout_marginStart="2.0dip"
            app:layout_constraintStart_toEndOf="@id/img_robi_logo"
            app:layout_constraintTop_toTopOf="@id/img_robi_logo" />
        <TextView
            android:textSize="10.0sp"
            android:textColor="#ff2f2f2f"
            android:id="@id/tv_ready_kit_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="রেডি কিট"
            android:layout_marginStart="@dimen/dim_8dp"
            app:layout_constraintBottom_toTopOf="@id/guidelineMiddleMargin"
            app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
            app:layout_constraintTop_toTopOf="parent" />
        <TextView
            android:textSize="@dimen/_14sp"
            android:textStyle="bold"
            android:textColor="#ff2f2f2f"
            android:id="@id/tv_ready_kit_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="৮"
            android:layout_marginStart="12.0dip"
            app:layout_constraintBaseline_toBaselineOf="@id/tv_ready_kit_label"
            app:layout_constraintBottom_toTopOf="@id/guidelineMiddleMargin"
            app:layout_constraintStart_toEndOf="@id/guidelineVerticalMiddleMargin" />
        <TextView
            android:textSize="10.0sp"
            android:textColor="#ff2f2f2f"
            android:id="@id/tv_block_kit_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4.0dip"
            android:text="ব্লক কিট"
            android:layout_marginStart="@dimen/dim_8dp"
            app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
            app:layout_constraintTop_toBottomOf="@id/guidelineMiddleMargin" />
        <TextView
            android:textSize="@dimen/_14sp"
            android:textStyle="bold"
            android:textColor="#ff2f2f2f"
            android:id="@id/tv_block_kit_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="১২"
            android:layout_marginStart="12.0dip"
            app:layout_constraintBaseline_toBaselineOf="@id/tv_block_kit_label"
            app:layout_constraintStart_toEndOf="@id/guidelineVerticalMiddleMargin" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
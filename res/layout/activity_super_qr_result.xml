<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    android:background="@color/base_background"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:fillViewport="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="@dimen/_24dp"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@id/llSuccessSection"
            android:paddingTop="@dimen/_32dp"
            android:paddingBottom="@dimen/_16dp"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@id/ivSuccessIcon"
                android:layout_width="72.0dip"
                android:layout_height="72.0dip"
                app:srcCompat="@drawable/ic_round_tick_filled" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_16sp"
                android:textStyle="bold"
                android:textColor="@color/black_800"
                android:id="@id/tvSuccessTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12dp"
                android:text="Recharge successful" />
        </LinearLayout>
        <androidx.cardview.widget.CardView
            android:id="@id/cvSuccessCard"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_16dp"
            android:layout_marginEnd="@dimen/_16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/_12dp"
            app:cardElevation="1.0dip">
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/_12dp"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/llCommission"
                    android:background="@drawable/bg_commission_banner"
                    android:paddingTop="@dimen/_10dp"
                    android:paddingBottom="@dimen/_10dp"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/_8dp"
                    android:paddingEnd="@dimen/_8dp">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@id/ivCommissionIcon"
                        android:layout_width="@dimen/_16dp"
                        android:layout_height="@dimen/_16dp"
                        app:srcCompat="@drawable/ic_commission_offer"
                        app:tint="@color/green_600" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_14sp"
                        android:id="@id/tvCommissionMessage"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0"
                        android:layout_marginStart="@dimen/_6dp" />
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@id/rvSuccessItems"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4dp"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@id/llFailedSection"
            android:paddingTop="@dimen/_24dp"
            android:paddingBottom="@dimen/_16dp"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@id/ivFailedIcon"
                android:layout_width="72.0dip"
                android:layout_height="72.0dip"
                app:srcCompat="@drawable/ic_recharge_failed" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_16sp"
                android:textStyle="bold"
                android:textColor="@color/black_800"
                android:id="@id/tvFailedTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12dp"
                android:text="Recharge Failed !" />
        </LinearLayout>
        <androidx.cardview.widget.CardView
            android:id="@id/cvFailedCard"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_16dp"
            android:layout_marginEnd="@dimen/_16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/_12dp"
            app:cardElevation="1.0dip">
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/_12dp"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@id/rvFailedItems"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
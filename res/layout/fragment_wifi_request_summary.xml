<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.core.widget.NestedScrollView
        android:id="@id/scrollContent"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/clProceed"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="@dimen/_16dp"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@id/guidelineStartMargin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_begin="@dimen/_16dp" />
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@id/guidelineEndMargin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_end="@dimen/_16dp" />
            <androidx.cardview.widget.CardView
                android:id="@id/cvHeader"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20dp"
                android:layout_marginStart="@dimen/_16dp"
                android:layout_marginEnd="@dimen/_16dp"
                app:cardCornerRadius="@dimen/_12dp"
                app:cardElevation="@dimen/_2dp"
                app:layout_constrainedHeight="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_gravity="center"
                    android:paddingTop="@dimen/_12dp"
                    android:paddingBottom="@dimen/_12dp"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:paddingStart="@dimen/_16dp"
                    android:paddingEnd="@dimen/_20dp"
                    android:paddingVertical="@dimen/_12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_14sp"
                        android:textStyle="bold"
                        android:textColor="@color/black_800"
                        android:gravity="center_horizontal"
                        android:id="@id/txtOrderSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/order_summary"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_12sp"
                        android:textColor="@color/black_500"
                        android:gravity="center_horizontal"
                        android:id="@id/tvPhoneNo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_12dp"
                        android:text="Phone No"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/txtOrderSummary" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_12sp"
                        android:textColor="@color/black_800"
                        android:gravity="center_horizontal"
                        android:id="@id/tvPhoneNoValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tvPhoneNo" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_12sp"
                        android:textColor="@color/black_500"
                        android:gravity="center_horizontal"
                        android:id="@id/tvRouterModel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8dp"
                        android:text="Router Model"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvPhoneNo" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_12sp"
                        android:textColor="@color/black_800"
                        android:gravity="center_horizontal"
                        android:id="@id/tvRouterModelValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tvRouterModel" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_12sp"
                        android:textColor="@color/black_500"
                        android:gravity="center_horizontal"
                        android:id="@id/tvRouterSerial"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8dp"
                        android:text="Router Serial"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvRouterModel" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_12sp"
                        android:textColor="@color/black_800"
                        android:gravity="center_horizontal"
                        android:id="@id/tvRouterSerialValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Robi Wifi Basic"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tvRouterSerial" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_14sp"
                android:textStyle="bold"
                android:textColor="@color/black_800"
                android:id="@id/tvSelfCareNumber"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_22dp"
                android:text="@string/profile_number"
                app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
                app:layout_constraintTop_toBottomOf="@id/cvHeader" />
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="16.0sp"
                android:textColor="@color/black_800"
                android:id="@id/etSelfCareNumber"
                android:background="@drawable/bg_number_input"
                android:padding="12.0dip"
                android:layout_width="fill_parent"
                android:layout_height="52.0dip"
                android:layout_margin="16.0dip"
                android:layout_marginTop="@dimen/_12dp"
                android:hint="@string/_01xxx"
                android:drawablePadding="@dimen/_2dp"
                android:inputType="number"
                android:drawableStart="@drawable/ic_mobile"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSelfCareNumber" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_14sp"
                android:textStyle="bold"
                android:textColor="@color/black_800"
                android:id="@id/tvAlternateNumber"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_22dp"
                android:text="@string/notification_self_care_number"
                app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
                app:layout_constraintTop_toBottomOf="@id/etSelfCareNumber" />
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="16.0sp"
                android:textColor="@color/black_800"
                android:id="@id/etAlternateNumber"
                android:background="@drawable/bg_number_input"
                android:padding="12.0dip"
                android:layout_width="fill_parent"
                android:layout_height="52.0dip"
                android:layout_margin="16.0dip"
                android:layout_marginTop="@dimen/_12dp"
                android:hint="@string/_01xxx"
                android:maxLength="11"
                android:drawablePadding="@dimen/_2dp"
                android:inputType="number"
                android:drawableStart="@drawable/ic_mobile"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvAlternateNumber"
                app:layout_constraintVertical_bias="0.0" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/clProceed"
        android:background="@drawable/bg_recharge_bottom_btn"
        android:layout_width="fill_parent"
        android:layout_height="108.0dip"
        android:elevation="@dimen/_8dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="1.0">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/layoutClProceed"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16dp"
            android:layout_marginBottom="@dimen/_16dp"
            android:layout_marginStart="@dimen/_16dp"
            android:layout_marginEnd="@dimen/_16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_14sp"
                android:textColor="@color/black_500"
                android:gravity="center"
                android:id="@id/btnBack"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/_48dp"
                android:layout_margin="@dimen/_2dp"
                android:text="@string/back"
                android:layout_weight="1.0"
                android:textAllCaps="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTC" />
            <com.google.android.material.button.MaterialButton
                android:textSize="@dimen/_14sp"
                android:id="@id/btnProceed"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/_48dp"
                android:layout_margin="@dimen/_2dp"
                android:text="@string/next"
                android:layout_weight="1.0"
                android:insetTop="0.0dip"
                android:insetBottom="0.0dip"
                android:textAllCaps="false"
                app:cornerRadius="@dimen/_32dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTC"
                style="@style/Button_Red_Body.RechargePanel" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    android:id="@id/cardView"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/_8dp"
    android:layout_marginTop="@dimen/_6dp"
    android:layout_marginRight="@dimen/_8dp"
    android:layout_marginBottom="@dimen/_6dp"
    android:layout_marginHorizontal="@dimen/_8dp"
    android:layout_marginVertical="@dimen/_6dp"
    app:cardCornerRadius="@dimen/_12dp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/white"
        android:padding="@dimen/_12dp"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@id/llUserInfo"
            android:layout_width="@dimen/_0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_6dp"
            app:layout_constraintEnd_toStartOf="@id/btnAssign"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_12sp"
                android:textStyle="normal"
                android:textColor="@color/black_500"
                android:id="@id/tvUserType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DSR 01" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_14sp"
                android:textStyle="bold"
                android:textColor="@color/black_800"
                android:id="@id/tvUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2dp"
                android:text="Jiaur Rahman" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_12sp"
                android:textStyle="normal"
                android:textColor="@color/black_800"
                android:id="@id/tvUserNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" 01888326589" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:textSize="@dimen/_14sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:id="@id/btnAssign"
            android:layout_width="0.0dip"
            android:layout_height="@dimen/_40dp"
            android:text="Assign"
            android:insetTop="0.0dip"
            android:insetBottom="0.0dip"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/_6dp"
            android:backgroundTint="@color/easy_plan_btn_tint"
            app:cornerRadius="24.0dip"
            app:icon="@drawable/ic_assign"
            app:iconGravity="textStart"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/llUserInfo"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_recharge_bottom_btn"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:elevation="@dimen/_8dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintVertical_bias="1.0">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@id/guidelineStartMargin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="@dimen/_16dp" />
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@id/guidelineEndMargin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="@dimen/_16dp" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/top_bar_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <View
                android:id="@id/view2"
                android:background="@drawable/bg_bottom_sheet_header_shape"
                android:layout_width="@dimen/_32dp"
                android:layout_height="4.0dip"
                android:layout_marginTop="@dimen/_24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@id/ivClose"
                android:layout_width="30.0dip"
                android:layout_height="30.0dip"
                android:layout_marginTop="@dimen/_24dp"
                android:layout_marginEnd="16.5dip"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_grey_close" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <bd.com.robi.redcube.custom_view.CustomOfferView
            android:id="@id/offerView"
            android:visibility="gone"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
            app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
            app:layout_constraintTop_toBottomOf="@id/top_bar_layout" />
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_20sp"
            android:textStyle="bold"
            android:textColor="@color/black_800"
            android:gravity="center"
            android:id="@id/tvAmount"
            android:visibility="gone"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12dp"
            app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
            app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
            app:layout_constraintTop_toBottomOf="@id/offerView" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/clmiddle"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAmount">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_14sp"
                android:textStyle="bold"
                android:textColor="@color/black_800"
                android:gravity="center_horizontal"
                android:id="@id/txtEnterPin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_24dp"
                android:text="@string/text_e_pin"
                android:layout_marginStart="@dimen/_8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_14sp"
                android:textColor="@color/black_500"
                android:gravity="center_horizontal"
                android:id="@id/txtEnterSubscriberPin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4dp"
                android:text="@string/text_subscriber_pin"
                android:layout_marginStart="@dimen/_8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtEnterPin" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/clRobiPin"
            android:background="@drawable/bg_rectangle_shape"
            android:layout_width="0.0dip"
            android:layout_height="52.0dip"
            android:layout_marginTop="20.0dip"
            app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
            app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
            app:layout_constraintTop_toBottomOf="@id/clmiddle">
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@id/guidelineMiddleMargin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.8" />
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@id/ivSubscriberIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_brand_robi" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_14sp"
                android:textColor="@color/black_500"
                android:gravity="center_horizontal"
                android:id="@id/txtSubscriberPin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_robi_pin"
                android:layout_marginStart="@dimen/_8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivSubscriberIcon"
                app:layout_constraintTop_toTopOf="parent" />
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="@dimen/_14sp"
                android:textColorHint="@color/light_grey"
                android:id="@id/etPin"
                android:background="@null"
                android:layout_width="wrap_content"
                android:layout_height="0.0dip"
                android:hint="xxxx"
                android:maxLength="4"
                android:inputType="numberPassword"
                android:nextFocusForward="@id/etAmount"
                android:paddingStart="@dimen/_4dp"
                android:paddingEnd="@dimen/_4dp"
                android:layout_marginStart="@dimen/_8dp"
                android:layout_marginEnd="@dimen/_8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/guidelineMiddleMargin"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/clAirtelPin"
            android:background="@drawable/bg_rectangle_shape"
            android:visibility="gone"
            android:layout_width="0.0dip"
            android:layout_height="52.0dip"
            android:layout_marginTop="20.0dip"
            app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
            app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
            app:layout_constraintTop_toBottomOf="@id/clRobiPin">
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@id/guidelineAirtelMiddleMargin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.8" />
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@id/ivAirtelSubscriberIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_brand_airtel" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_14sp"
                android:textColor="@color/black_500"
                android:gravity="center_horizontal"
                android:id="@id/txtAirtelSubscriberPin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_airtel_pin"
                android:layout_marginStart="@dimen/_8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivAirtelSubscriberIcon"
                app:layout_constraintTop_toTopOf="parent" />
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="@dimen/_14sp"
                android:textColorHint="@color/light_grey"
                android:id="@id/etAirtelPin"
                android:background="@null"
                android:layout_width="wrap_content"
                android:layout_height="0.0dip"
                android:hint="xxxx"
                android:maxLength="4"
                android:inputType="numberPassword"
                android:nextFocusForward="@id/etAmount"
                android:paddingStart="@dimen/_4dp"
                android:paddingEnd="@dimen/_4dp"
                android:layout_marginStart="@dimen/_8dp"
                android:layout_marginEnd="@dimen/_8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/guidelineAirtelMiddleMargin"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/clError"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8.0dip"
            android:layout_marginBottom="4.0dip"
            app:layout_constraintBottom_toTopOf="@id/clRechargeButton"
            app:layout_constraintTop_toBottomOf="@id/clAirtelPin">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@id/ivLowBalance"
                android:paddingTop="2.0dip"
                android:layout_width="@dimen/_16dp"
                android:layout_height="@dimen/_16dp"
                android:layout_marginTop="@dimen/_5dp"
                android:layout_marginStart="16.0dip"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_error_info_circle" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_12sp"
                android:textStyle="normal"
                android:textColor="@color/warning_color"
                android:gravity="start|center"
                android:id="@id/tvErrorPin"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_marginTop="@dimen/_5dp"
                android:text="@string/enter_correct_pin"
                android:layout_marginStart="@dimen/_2dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivLowBalance"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/clRechargeButton"
            android:background="@drawable/bg_recharge_bottom_btn"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16dp"
            android:layout_marginBottom="@dimen/_32dp"
            android:elevation="@dimen/_8dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
            app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
            app:layout_constraintTop_toBottomOf="@id/clError"
            app:layout_constraintVertical_bias="1.0">
            <com.google.android.material.button.MaterialButton
                android:id="@id/btnRecharge"
                android:layout_width="0.0dip"
                android:layout_height="@dimen/_48dp"
                android:layout_marginTop="@dimen/_12dp"
                android:layout_marginBottom="@dimen/_16dp"
                android:text="@string/btn_recharge"
                android:insetTop="@dimen/_0dp"
                android:insetBottom="@dimen/_0dp"
                android:textAllCaps="false"
                android:layout_marginStart="@dimen/_16dp"
                android:layout_marginEnd="@dimen/_16dp"
                app:cornerRadius="@dimen/_32dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Button_Red_Body.RechargePanel" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:fillViewport="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/base_background"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@id/guidelineStartMargin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="@dimen/_16dp" />
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@id/guidelineEndMargin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="@dimen/_16dp" />
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@id/guidelineTopMargin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.05" />
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@id/guidelineTop_60_Margin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.6" />
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@id/guideline_25_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.25" />
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_16sp"
            android:textColor="@color/black"
            android:gravity="center_horizontal"
            android:id="@id/txtOtp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12dp"
            android:text="@string/text_otp"
            app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
            app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
            app:layout_constraintTop_toTopOf="parent" />
        <bd.com.robi.redcube.custom_view.inputViewPin.InputView6DigitOTP
            android:id="@id/inputViewOTP"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_24dp"
            app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
            app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
            app:layout_constraintTop_toBottomOf="@id/txtOtp" />
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/black"
            android:gravity="center_horizontal"
            android:id="@id/txtResendOtp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_24dp"
            android:text="@string/text_resend_otp"
            app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
            app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
            app:layout_constraintTop_toBottomOf="@id/inputViewOTP" />
        <com.google.android.material.button.MaterialButton
            android:id="@id/btnLogin"
            android:layout_width="0.0dip"
            android:layout_height="@dimen/_48dp"
            android:layout_marginTop="@dimen/_32dp"
            android:layout_marginBottom="@dimen/_16dp"
            android:text="@string/btn_submit"
            android:insetTop="@dimen/_0dp"
            android:insetBottom="@dimen/_0dp"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/_16dp"
            android:layout_marginEnd="@dimen/_16dp"
            app:cornerRadius="@dimen/_32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtResendOtp"
            style="@style/Button_Red_Body.RechargePanel" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/clEtafAccess"
            android:background="@drawable/bg_common_bottom"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:elevation="@dimen/_8dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="1.0">
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/clEtsafLayout"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_24dp"
                android:layout_marginBottom="@dimen/_36dp"
                android:layout_marginStart="@dimen/_16dp"
                android:layout_marginEnd="@dimen/_16dp"
                app:layout_constrainedHeight="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.google.android.material.button.MaterialButton
                    android:id="@id/btnInputManually"
                    android:layout_width="fill_parent"
                    android:layout_height="@dimen/_43dp"
                    android:layout_margin="@dimen/_2dp"
                    android:text="@string/input_manually"
                    android:layout_weight="1.0"
                    android:insetTop="0.0dip"
                    android:insetBottom="0.0dip"
                    android:textAllCaps="false"
                    app:cornerRadius="@dimen/_32dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Button_Red_Body.RechargePanel" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textColor="@color/black_500"
                    android:gravity="center"
                    android:id="@id/btnScanNid"
                    android:layout_width="fill_parent"
                    android:layout_height="@dimen/_48dp"
                    android:layout_marginTop="@dimen/_8dp"
                    android:text="@string/scan"
                    android:layout_weight="1.0"
                    android:textAllCaps="false"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
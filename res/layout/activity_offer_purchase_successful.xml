<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/main"
    android:background="@color/base_background"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@id/guidelineStartMargin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/_16dp" />
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@id/guidelineEndMargin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/_16dp" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/clmiddle"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@id/ivSuccess"
            android:layout_width="62.0dip"
            android:layout_height="62.0dip"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_success_animation" />
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_26sp"
            android:textStyle="bold"
            android:textColor="@color/black_800"
            android:gravity="center_horizontal"
            android:id="@id/txtPurchaseSuccessful"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16dp"
            android:text="@string/text_gstore_recharge_successful"
            android:layout_marginStart="@dimen/_8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivSuccess" />
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_14sp"
            android:textColor="@color/black_500"
            android:gravity="center_horizontal"
            android:id="@id/txtPurchaseSuccessfulLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4dp"
            android:text="@string/text_gstore_recharge_successful_line"
            android:layout_marginStart="@dimen/_8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtPurchaseSuccessful" />
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_14sp"
            android:textStyle="bold"
            android:textColor="@color/black_800"
            android:gravity="center_horizontal"
            android:id="@id/txtMsisdn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2dp"
            android:text=" 01833184096"
            android:layout_marginStart="@dimen/_8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtPurchaseSuccessfulLine" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/clOffer"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_16dp"
        android:layout_marginStart="@dimen/_8dp"
        android:layout_marginEnd="@dimen/_8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clmiddle">
        <androidx.cardview.widget.CardView
            android:id="@id/cvOfferView"
            android:background="@android:color/white"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8dp"
            android:layout_marginBottom="@dimen/_8dp"
            android:layout_marginStart="@dimen/_8dp"
            android:layout_marginEnd="@dimen/_8dp"
            app:cardCornerRadius="12.0dip"
            app:cardElevation="@dimen/_4dp"
            app:cardPreventCornerOverlap="false"
            app:cardUseCompatPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:padding="12.0dip"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
                <TextView
                    android:textSize="@dimen/_14sp"
                    android:textStyle="bold"
                    android:textColor="@color/black_800"
                    android:id="@id/tv_offer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:orientation="horizontal"
                    android:id="@id/clValidity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_offer">
                    <ImageView
                        android:id="@id/ivValidity"
                        android:layout_width="16.0dip"
                        android:layout_height="16.0dip"
                        android:src="@drawable/ic_calender_offer"
                        android:layout_marginEnd="@dimen/_4dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                    <TextView
                        android:textSize="@dimen/_12sp"
                        android:textColor="@color/black_500"
                        android:id="@id/tvValidity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/ivValidity"
                        app:layout_constraintTop_toTopOf="parent" />
                    <ImageView
                        android:id="@id/ivCommission"
                        android:layout_width="16.0dip"
                        android:layout_height="16.0dip"
                        android:src="@drawable/ic_commission_offer"
                        android:layout_marginStart="@dimen/_8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tvValidity"
                        app:layout_constraintTop_toTopOf="parent" />
                    <TextView
                        android:textSize="@dimen/_12sp"
                        android:textColor="@color/green_500"
                        android:id="@id/tvCommission"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/ivCommission"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:textSize="@dimen/_16sp"
                    android:textStyle="bold"
                    android:textColor="#ff000000"
                    android:id="@id/tvPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="@id/clValidity"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/clValidity" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/clWhatNext"
        android:visibility="gone"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_16dp"
        android:layout_marginBottom="@dimen/_16dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
        app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
        app:layout_constraintTop_toBottomOf="@id/clOffer"
        app:layout_constraintVertical_bias="0.0">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_16sp"
            android:textStyle="bold"
            android:textColor="@color/black_800"
            android:id="@id/tvWhatNext"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/what_s_next"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@id/imgWhatNext"
            android:layout_width="fill_parent"
            android:layout_height="180.0dip"
            android:layout_marginTop="@dimen/_24dp"
            android:scaleType="centerCrop"
            android:layout_marginStart="@dimen/_16dp"
            android:layout_marginEnd="@dimen/_16dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvWhatNext"
            app:shapeAppearanceOverlay="@style/Rounded8dp"
            app:srcCompat="@drawable/what_next" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/black_500"
        android:gravity="center"
        android:id="@id/txtBackHome"
        android:layout_width="0.0dip"
        android:layout_height="@dimen/_48dp"
        android:layout_marginTop="@dimen/_24dp"
        android:layout_marginBottom="@dimen/_20dp"
        android:text="@string/btn_return_to_home_text"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/_16dp"
        android:layout_marginEnd="@dimen/_16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clWhatNext" />
</androidx.constraintlayout.widget.ConstraintLayout>
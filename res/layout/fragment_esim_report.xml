<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:background="@color/page_background"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@id/guidelineStartMarginParent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/_16dp" />
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@id/guidelineEndMarginParent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/_16dp" />
    <androidx.cardview.widget.CardView
        android:id="@id/cvDateView"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12dp"
        app:cardCornerRadius="@dimen/_8dp"
        app:cardElevation="@dimen/_2dp"
        app:layout_constraintEnd_toEndOf="@id/guidelineEndMarginParent"
        app:layout_constraintStart_toStartOf="@id/guidelineStartMarginParent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/clDateHeader"
            android:background="@color/white"
            android:paddingTop="@dimen/_13dp"
            android:paddingBottom="@dimen/_13dp"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/_13dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_12sp"
                android:textColor="@color/black_500"
                android:id="@id/textDateShow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/showing_for"
                android:layout_marginStart="@dimen/_12dp"
                android:layout_marginEnd="@dimen/_8dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_12sp"
                android:textStyle="bold"
                android:textColor="@color/black_800"
                android:id="@id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/today"
                android:layout_marginStart="@dimen/_4dp"
                android:layout_marginEnd="@dimen/_8dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toStartOf="@id/imageViewDate"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toEndOf="@id/textDateShow"
                app:layout_constraintTop_toTopOf="parent" />
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@id/imageViewDate"
                android:layout_width="@dimen/_20dp"
                android:layout_height="@dimen/_20dp"
                android:layout_marginEnd="@dimen/_14_5dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_calender" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:id="@id/cvSearchView"
        android:background="@color/white"
        android:layout_width="0.0dip"
        android:layout_height="@dimen/_40dp"
        android:layout_marginTop="@dimen/_12dp"
        app:cardCornerRadius="@dimen/_8dp"
        app:layout_constraintEnd_toEndOf="@id/guidelineEndMarginParent"
        app:layout_constraintStart_toStartOf="@id/guidelineStartMarginParent"
        app:layout_constraintTop_toBottomOf="@id/cvDateView">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@id/ivSearch"
                android:layout_width="18.0dip"
                android:layout_height="18.0dip"
                android:layout_marginStart="@dimen/_12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_search" />
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="@dimen/_14sp"
                android:textColorHint="@color/light_grey"
                android:id="@id/etSearch"
                android:background="@null"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:hint="@string/search_by_number"
                android:inputType="number"
                android:imeOptions="actionSearch"
                android:paddingStart="@dimen/_4dp"
                android:paddingEnd="@dimen/_4dp"
                android:layout_marginStart="@dimen/_8dp"
                android:layout_marginEnd="@dimen/_8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivSearch"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@id/rvResults"
        android:background="@drawable/bg_rectangle_shape"
        android:paddingLeft="@dimen/_12dp"
        android:paddingRight="@dimen/_12dp"
        android:paddingBottom="@dimen/_12dp"
        android:clipToPadding="false"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_marginTop="@dimen/_12dp"
        android:layout_marginBottom="@dimen/_12dp"
        android:paddingHorizontal="@dimen/_12dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/guidelineEndMarginParent"
        app:layout_constraintStart_toStartOf="@id/guidelineStartMarginParent"
        app:layout_constraintTop_toBottomOf="@id/cvSearchView" />
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/_14sp"
        android:textColor="@color/black_500"
        android:id="@id/tvNoData"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_data_found"
        app:layout_constraintBottom_toBottomOf="@id/rvResults"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/rvResults" />
</androidx.constraintlayout.widget.ConstraintLayout>
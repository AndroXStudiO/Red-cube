<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:background="@color/base_background"
    android:paddingTop="@dimen/_12dp"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@id/guidelineStartMargin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/_16dp" />
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@id/guidelineEndMargin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/_16dp" />
    <TextView
        android:textSize="@dimen/_12sp"
        android:textStyle="bold"
        android:textColor="@color/black_800"
        android:gravity="start"
        android:id="@id/tvMenuSectionTitle"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_10dp"
        android:layout_marginRight="@dimen/_10dp"
        android:text="@string/menu_support"
        android:layout_marginHorizontal="@dimen/_10dp"
        app:layout_constraintBottom_toTopOf="@id/recyclerView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineEndMargin"
        app:layout_constraintStart_toEndOf="@id/guidelineStartMargin"
        app:layout_constraintTop_toTopOf="parent" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@id/recyclerView"
        android:paddingBottom="@dimen/_4dp"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_16dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineEndMargin"
        app:layout_constraintStart_toEndOf="@id/guidelineStartMargin"
        app:layout_constraintTop_toBottomOf="@id/tvMenuSectionTitle"
        app:spanCount="2" />
</androidx.constraintlayout.widget.ConstraintLayout>
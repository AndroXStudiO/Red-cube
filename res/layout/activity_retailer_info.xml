<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/main"
    android:background="@color/app_bar_bg"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/_12sp"
        android:textStyle="bold"
        android:textColor="@color/black_800"
        android:gravity="center_vertical"
        android:id="@id/tvRetailerInfo"
        android:layout_width="@dimen/_0dp"
        android:layout_height="@dimen/_24dp"
        android:layout_margin="@dimen/_16dp"
        android:text="@string/retailer_information"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <androidx.cardview.widget.CardView
        android:id="@id/cvRetailerInfo"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10dp"
        android:layout_marginStart="@dimen/_16dp"
        android:layout_marginEnd="@dimen/_16dp"
        android:elevation="@dimen/_2dp"
        app:cardCornerRadius="@dimen/_12dp"
        app:layout_constraintTop_toBottomOf="@id/tvRetailerInfo">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@id/rvRetailerInfo"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12dp"
            android:layout_marginBottom="@dimen/_12dp"
            android:layout_marginVertical="@dimen/_12dp"
            app:layout_constraintTop_toBottomOf="@id/tvRetailerInfo" />
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:id="@id/cvSearchView"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="0.0dip"
        android:layout_height="@dimen/_40dp"
        android:layout_marginTop="@dimen/_10dp"
        android:layout_marginStart="@dimen/_16dp"
        android:layout_marginEnd="@dimen/_16dp"
        app:cardCornerRadius="@dimen/_8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@id/ivSearch"
                android:layout_width="18.0dip"
                android:layout_height="18.0dip"
                android:layout_marginStart="@dimen/_12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_search" />
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="@dimen/_14sp"
                android:textColorHint="@color/light_grey"
                android:id="@id/etSearch"
                android:background="@null"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:hint="@string/search_retailer"
                android:maxLength="11"
                android:inputType="number"
                android:imeOptions="actionNext"
                android:nextFocusForward="@id/etAmount"
                android:paddingStart="@dimen/_4dp"
                android:paddingEnd="@dimen/_4dp"
                android:layout_marginStart="@dimen/_8dp"
                android:layout_marginEnd="@dimen/_8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivSearch"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:id="@id/cvSearchResult"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10dp"
        android:layout_marginStart="@dimen/_16dp"
        android:layout_marginEnd="@dimen/_16dp"
        android:elevation="@dimen/_2dp"
        app:cardCornerRadius="@dimen/_12dp"
        app:layout_constraintTop_toBottomOf="@id/cvSearchView">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_12sp"
                android:textColor="@color/black_500"
                android:id="@id/tvSearchResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_12dp"
                android:text="@string/search_result"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@id/rvRetailerSearch"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_12dp"
                android:layout_marginRight="@dimen/_12dp"
                android:layout_marginHorizontal="@dimen/_12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSearchResult" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
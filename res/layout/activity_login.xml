<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:fillViewport="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/base_background"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@id/guidelineStartMargin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="@dimen/_16dp" />
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@id/guidelineEndMargin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="@dimen/_16dp" />
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@id/guidelineTopMargin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.05" />
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@id/guidelineTop_60_Margin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.6" />
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@id/guideline_25_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.25" />
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@id/guideline_75_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.8" />
        <bd.com.robi.redcube.ui.more.CustomSwitch
            android:id="@id/switchLanguageChange"
            android:layout_width="160.0dip"
            android:layout_height="@dimen/_30dp"
            android:layout_marginTop="@dimen/_21dp"
            android:layout_marginEnd="@dimen/_16dp"
            app:cs_initial_selection="left"
            app:cs_left_text="English"
            app:cs_right_text="বাংলা"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@id/imageViewLogo"
            android:layout_width="@dimen/_64dp"
            android:layout_height="@dimen/_64dp"
            android:layout_marginTop="@dimen/_58dp"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
            app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
            app:layout_constraintTop_toBottomOf="@id/switchLanguageChange"
            app:srcCompat="@drawable/ic_logo_new" />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@id/text_input_layout"
            android:background="@drawable/text_field_background"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/_56dp"
            android:layout_marginLeft="@dimen/_16dp"
            android:layout_marginTop="@dimen/_37dp"
            android:layout_marginRight="@dimen/_16dp"
            android:hint="@string/enter_text_Mobile"
            app:boxBackgroundColor="@android:color/transparent"
            app:boxCollapsedPaddingTop="4.0dip"
            app:boxStrokeWidth="0.0dip"
            app:boxStrokeWidthFocused="0.0dip"
            app:expandedHintEnabled="false"
            app:hintTextAppearance="@style/CustomHintText"
            app:hintTextColor="@color/black_500"
            app:layout_constraintTop_toBottomOf="@id/imageViewLogo">
            <bd.com.robi.redcube.ui.login.AnimatedHintEditText
                android:id="@id/edit_text_mobile_no"
                android:background="@android:color/transparent"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:maxLength="11"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/clMobileNumberError"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8.0dip"
            app:layout_constraintTop_toBottomOf="@id/text_input_layout">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@id/ivLowBalance"
                android:layout_width="@dimen/_16dp"
                android:layout_height="@dimen/_16dp"
                android:layout_marginTop="@dimen/_5dp"
                android:layout_marginStart="16.0dip"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_error_info_circle" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_12sp"
                android:textStyle="normal"
                android:textColor="@color/error_500"
                android:gravity="start|center"
                android:id="@id/tvErrorMobileNumber"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:text="@string/please_enter_your_phone_number_first"
                android:layout_marginStart="@dimen/_8dp"
                app:layout_constraintBaseline_toBaselineOf="@id/ivLowBalance"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivLowBalance"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@id/passwordInputLayout"
            android:background="@drawable/text_field_background"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/_56dp"
            android:layout_marginLeft="@dimen/_16dp"
            android:layout_marginTop="@dimen/_12dp"
            android:layout_marginRight="@dimen/_16dp"
            android:hint="@string/enter_password"
            app:boxBackgroundColor="@android:color/transparent"
            app:boxCollapsedPaddingTop="4.0dip"
            app:boxStrokeWidth="0.0dip"
            app:boxStrokeWidthFocused="0.0dip"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/black"
            app:hintTextAppearance="@style/CustomHintText"
            app:hintTextColor="@color/black_500"
            app:layout_constraintTop_toBottomOf="@id/clMobileNumberError">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@id/editTextPassword"
                android:background="@android:color/transparent"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:maxLength="16"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/clPasswordError"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8.0dip"
            android:layout_marginBottom="4.0dip"
            app:layout_constraintTop_toBottomOf="@id/passwordInputLayout">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@id/ivPassword"
                android:layout_width="@dimen/_16dp"
                android:layout_height="@dimen/_16dp"
                android:layout_marginTop="@dimen/_5dp"
                android:layout_marginStart="16.0dip"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_error_info_circle" />
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_12sp"
                android:textStyle="normal"
                android:textColor="@color/error_500"
                android:gravity="start|center"
                android:id="@id/tvErrorPassword"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_marginTop="@dimen/_5dp"
                android:text="@string/please_enter_your_password"
                android:layout_marginStart="@dimen/_8dp"
                app:layout_constraintBaseline_toBaselineOf="@id/ivPassword"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivPassword"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <CheckBox
            android:textSize="@dimen/_12sp"
            android:id="@id/checkBoxPrivacyPolicy"
            android:background="@android:color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20dp"
            android:checked="true"
            android:paddingStart="@dimen/_8dp"
            android:paddingEnd="0.0dip"
            app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
            app:layout_constraintTop_toBottomOf="@id/clPasswordError"
            style="@style/check_box_terms_condition_agreement" />
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_12sp"
            android:textStyle="normal"
            android:textColor="@color/black_800"
            android:gravity="start|center"
            android:id="@id/tvPrivacyPolicy"
            android:layout_width="0.0dip"
            android:layout_height="0.0dip"
            android:text="@string/text_check_privacy_policy"
            android:layout_marginStart="@dimen/_8dp"
            app:layout_constraintBottom_toBottomOf="@id/checkBoxPrivacyPolicy"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/checkBoxPrivacyPolicy"
            app:layout_constraintTop_toTopOf="@id/checkBoxPrivacyPolicy" />
        <com.google.android.material.button.MaterialButton
            android:textSize="@dimen/_14sp"
            android:textStyle="bold"
            android:id="@id/btnLogin"
            android:layout_width="0.0dip"
            android:layout_height="@dimen/_48dp"
            android:layout_marginTop="@dimen/_20dp"
            android:text="@string/btn_login"
            android:insetTop="0.0dip"
            android:insetBottom="0.0dip"
            android:textAllCaps="false"
            android:textAlignment="center"
            app:cornerRadius="@dimen/_32dp"
            app:layout_constraintEnd_toEndOf="@id/guideline_75_percent"
            app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
            app:layout_constraintTop_toBottomOf="@id/checkBoxPrivacyPolicy"
            style="@style/Button_Red_Body.RechargePanel" />
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@id/imageViewFingerPrint"
            android:layout_width="@dimen/_48dp"
            android:layout_height="@dimen/_48dp"
            android:layout_marginTop="@dimen/_20dp"
            android:layout_marginStart="@dimen/_8dp"
            app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
            app:layout_constraintStart_toEndOf="@id/guideline_75_percent"
            app:layout_constraintTop_toBottomOf="@id/checkBoxPrivacyPolicy"
            app:srcCompat="@drawable/ic_finger_print_login" />
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_14sp"
            android:textColor="@color/black_500"
            android:gravity="center_horizontal"
            android:id="@id/txtLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_27dp"
            android:layout_marginBottom="@dimen/_8dp"
            android:text="@string/text_forgot_password"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnLogin" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
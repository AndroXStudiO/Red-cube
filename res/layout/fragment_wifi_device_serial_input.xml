<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@id/guidelineStartMargin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/_16dp" />
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@id/guidelineEndMargin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/_16dp" />
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/_14sp"
        android:textStyle="bold"
        android:textColor="@color/black_800"
        android:id="@id/tvDeviceSelection"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_24dp"
        android:text="@string/please_select_device_model"
        app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
        app:layout_constraintTop_toTopOf="parent" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_offer_selected"
        android:padding="@dimen/_1dp"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10dp"
        app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
        app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
        app:layout_constraintTop_toBottomOf="@id/tvDeviceSelection">
        <androidx.appcompat.widget.AppCompatImageView
            android:gravity="center"
            android:id="@id/ivMenu"
            android:layout_width="100.0dip"
            android:layout_height="100.0dip"
            android:layout_marginTop="@dimen/_10dp"
            android:src="@drawable/ic_mobile"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/rowProductInfo"
            android:background="@color/black_50"
            android:padding="@dimen/_10dp"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivMenu">
            <TextView
                android:textSize="@dimen/_12sp"
                android:textColor="@color/black_800"
                android:id="@id/tvProduct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Product"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <TextView
                android:textSize="@dimen/_12sp"
                android:textColor="@color/black_700"
                android:id="@id/tvRetailerCodeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Robi Wifi Basic"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvProduct" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/clSerial"
            android:background="@drawable/bg_number_input"
            android:layout_width="0.0dip"
            android:layout_height="@dimen/_52dp"
            android:layout_marginLeft="@dimen/_8dp"
            android:layout_marginTop="@dimen/_12dp"
            android:layout_marginRight="@dimen/_8dp"
            android:layout_marginHorizontal="@dimen/_8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rowProductInfo">
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="16.0sp"
                android:textColor="@color/black_800"
                android:id="@id/etSerialNumber"
                android:background="@null"
                android:padding="12.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:hint="Enter IMEI"
                android:maxLength="22"
                android:drawablePadding="@dimen/_2dp"
                android:inputType="text"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <com.google.android.material.button.MaterialButton
                android:enabled="true"
                android:textSize="@dimen/_14sp"
                android:gravity="center"
                android:id="@id/btnScan"
                android:layout_width="0.0dip"
                android:layout_height="@dimen/_36dp"
                android:text="@string/scan"
                android:insetTop="0.0dip"
                android:insetBottom="0.0dip"
                android:textAllCaps="false"
                android:paddingStart="@dimen/_12dp"
                android:paddingEnd="@dimen/_12dp"
                android:layout_marginEnd="@dimen/_10dp"
                app:cornerRadius="@dimen/_42dp"
                app:icon="@drawable/ic_scan"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/_4dp"
                app:iconTint="@color/text_color_red_grey_recharge_panel"
                app:layout_constrainedHeight="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Button_Red_Border_Only.RechargePanel" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/clEtafAccess"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:elevation="@dimen/_8dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintTop_toBottomOf="@id/clSerial"
            app:layout_constraintVertical_bias="1.0">
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/clEtsafLayout"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20dp"
                android:layout_marginBottom="@dimen/_10dp"
                android:layout_marginStart="@dimen/_16dp"
                android:layout_marginEnd="@dimen/_16dp"
                app:layout_constrainedHeight="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.google.android.material.button.MaterialButton
                    android:id="@id/btnNext"
                    android:layout_width="fill_parent"
                    android:layout_height="@dimen/_43dp"
                    android:layout_margin="@dimen/_2dp"
                    android:text="@string/next"
                    android:layout_weight="1.0"
                    android:insetTop="0.0dip"
                    android:insetBottom="0.0dip"
                    android:textAllCaps="false"
                    app:cornerRadius="@dimen/_32dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Button_Red_Body.RechargePanel" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textColor="@color/black_500"
                    android:gravity="center"
                    android:id="@id/btnInputManually"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="@dimen/_48dp"
                    android:layout_marginTop="@dimen/_8dp"
                    android:text="@string/input_manually"
                    android:layout_weight="1.0"
                    android:textAllCaps="false"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
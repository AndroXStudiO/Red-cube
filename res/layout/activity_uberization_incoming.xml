<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:id="@id/rootIncomingRequest"
    android:background="#80000000"
    android:padding="16.0dip"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/cardIncomingRequest"
        android:background="@drawable/bg_notif_card_rounded"
        android:padding="20.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/llRequestType"
            android:background="@drawable/bg_black_100_solid"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_24dp"
            android:paddingStart="@dimen/_8dp"
            android:paddingEnd="@dimen/_8dp">
            <ImageView
                android:id="@id/ivBrand"
                android:layout_width="16.0dip"
                android:layout_height="16.0dip"
                android:src="@drawable/ic_brand_airtel" />
            <TextView
                android:textSize="@dimen/_12sp"
                android:textStyle="bold"
                android:textColor="@color/black_800"
                android:id="@id/tvRequestType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Sim"
                android:layout_marginStart="4.0dip" />
        </LinearLayout>
        <LinearLayout
            android:gravity="top"
            android:orientation="horizontal"
            android:id="@id/llOrderId"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16.0dip">
            <ImageView
                android:layout_width="@dimen/_18dp"
                android:layout_height="@dimen/_18dp"
                android:src="@drawable/ic_customer_profile" />
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:layout_marginStart="@dimen/_8dp">
                <TextView
                    android:textSize="14.0sp"
                    android:textColor="@color/black_800"
                    android:id="@id/tvOrderIdLabel"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="Order ID" />
                <TextView
                    android:textSize="18.0sp"
                    android:textStyle="bold"
                    android:textColor="@color/black_800"
                    android:id="@id/tvOrderId"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4.0dip" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="top"
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20.0dip">
            <ImageView
                android:layout_width="@dimen/_18dp"
                android:layout_height="@dimen/_18dp"
                android:src="@drawable/ic_location_marker" />
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:layout_marginStart="@dimen/_8dp">
                <TextView
                    android:textSize="14.0sp"
                    android:textColor="@color/black_800"
                    android:id="@id/tvDistanceLabel"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="Distance" />
                <TextView
                    android:textSize="18.0sp"
                    android:textStyle="bold"
                    android:textColor="@color/black_800"
                    android:id="@id/tvDistance"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4.0dip"
                    android:text="3.08 KM" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="top"
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18.0dip">
            <ImageView
                android:layout_width="@dimen/_18dp"
                android:layout_height="@dimen/_18dp"
                android:src="@drawable/ic_location_marker" />
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:layout_marginStart="@dimen/_8dp">
                <TextView
                    android:textSize="14.0sp"
                    android:textColor="@color/black_800"
                    android:id="@id/tvAddressLabel"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="Address" />
                <TextView
                    android:textSize="13.0sp"
                    android:textColor="@color/black_700"
                    android:ellipsize="end"
                    android:id="@id/tvAddress"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4.0dip"
                    android:text="Shop 1/A"
                    android:maxLines="4" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="top"
            android:orientation="horizontal"
            android:id="@id/llExpectedDeliveryDate"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18.0dip">
            <ImageView
                android:layout_width="@dimen/_18dp"
                android:layout_height="@dimen/_18dp"
                android:src="@null" />
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:layout_marginStart="@dimen/_8dp">
                <TextView
                    android:textSize="14.0sp"
                    android:textColor="@color/black_800"
                    android:id="@id/tvExpectedDeliveryDateLabel"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="Expected Delivery Date" />
                <TextView
                    android:textSize="18.0sp"
                    android:textStyle="bold"
                    android:textColor="@color/black_800"
                    android:id="@id/tvExpectedDeliveryDate"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4.0dip" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/layoutButtons"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24.0dip">
            <androidx.appcompat.widget.AppCompatButton
                android:textSize="14.0sp"
                android:textColor="@color/red"
                android:id="@id/btnReject"
                android:background="@drawable/bg_notif_btn_gray_border"
                android:layout_width="0.0dip"
                android:layout_height="48.0dip"
                android:text="Reject"
                android:layout_weight="1.0"
                android:textAllCaps="false"
                android:layout_marginEnd="8.0dip" />
            <androidx.appcompat.widget.AppCompatButton
                android:textSize="14.0sp"
                android:textColor="@color/white"
                android:id="@id/btnOkay"
                android:background="@drawable/bg_notif_btn_green"
                android:visibility="gone"
                android:layout_width="0.0dip"
                android:layout_height="48.0dip"
                android:text="Okay"
                android:layout_weight="1.0"
                android:textAllCaps="false"
                android:layout_marginStart="8.0dip" />
            <androidx.appcompat.widget.AppCompatButton
                android:textSize="14.0sp"
                android:textColor="@color/white"
                android:id="@id/btnAccept"
                android:background="@drawable/bg_notif_btn_green"
                android:layout_width="0.0dip"
                android:layout_height="48.0dip"
                android:text="Accept"
                android:layout_weight="1.0"
                android:textAllCaps="false"
                android:layout_marginStart="8.0dip" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/cardClubRequest"
        android:background="@drawable/bg_notif_card_rounded"
        android:padding="20.0dip"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@id/llClubBanner"
            android:background="@drawable/bg_club_banner"
            android:paddingLeft="@dimen/_16dp"
            android:paddingTop="20.0dip"
            android:paddingRight="@dimen/_16dp"
            android:paddingBottom="20.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_36dp"
            android:paddingHorizontal="@dimen/_16dp"
            android:paddingVertical="20.0dip">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="18.0sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@id/tvClubQueueCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/_8dp"
                app:drawableStartCompat="@drawable/ic_warning_triangle_white" />
            <TextView
                android:textSize="14.0sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@id/tvClubBannerSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4dp"
                android:text="Tap to review &amp; accept" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/layoutClubButtons"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="44.0dip"
            android:layout_marginBottom="@dimen/_36dp">
            <androidx.appcompat.widget.AppCompatButton
                android:textSize="14.0sp"
                android:textColor="@color/red"
                android:id="@id/btnClubDismiss"
                android:background="@drawable/bg_notif_btn_gray_border"
                android:layout_width="0.0dip"
                android:layout_height="48.0dip"
                android:text="Dismiss"
                android:layout_weight="1.0"
                android:textAllCaps="false"
                android:layout_marginEnd="8.0dip" />
            <androidx.appcompat.widget.AppCompatButton
                android:textSize="14.0sp"
                android:textColor="@color/white"
                android:id="@id/btnClubReview"
                android:background="@drawable/bg_notif_btn_green"
                android:layout_width="0.0dip"
                android:layout_height="48.0dip"
                android:text="Review"
                android:layout_weight="1.0"
                android:textAllCaps="false"
                android:layout_marginStart="8.0dip" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
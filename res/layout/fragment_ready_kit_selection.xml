                        android:id="@id/ivSuccessChooseNumber"
                        android:layout_width="62.0dip"
                        android:layout_height="62.0dip"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_success_animation" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_26sp"
                        android:textStyle="bold"
                        android:textColor="@color/black_800"
                        android:gravity="center_horizontal"
                        android:id="@id/txtAvailableNumberChooseNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_16dp"
                        android:text="018XXXXXXXX is available"
                        android:layout_marginStart="@dimen/_8dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/ivSuccessChooseNumber" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_14sp"
                        android:textColor="@color/black_700"
                        android:gravity="center_horizontal"
                        android:id="@id/txtProceedChooseNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4dp"
                        android:text="@string/proceed_with_numbers"
                        android:layout_marginStart="@dimen/_8dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/txtAvailableNumberChooseNumber" />
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@id/layoutVasChooseNumber"
                        android:layout_width="fill_parent"
                        android:layout_height="@dimen/_52dp"
                        android:layout_marginStart="@dimen/_4dp"
                        android:layout_marginEnd="@dimen/_4dp"
                        app:layout_constraintTop_toBottomOf="@id/txtProceedChooseNumber">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/_14sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:id="@id/tvTitleChooseNumber"
                            android:visibility="visible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/select_from_nearby_numbers"
                            android:layout_marginStart="@dimen/_16dp"
                            android:layout_marginEnd="16.0dip"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                        <androidx.appcompat.widget.AppCompatImageView
                            android:textColor="@color/black"
                            android:id="@id/ivCheckChooseNumber"
                            android:visibility="gone"
                            android:layout_width="@dimen/_22dp"
                            android:layout_height="@dimen/_22dp"
                            android:layout_marginEnd="@dimen/_10dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@drawable/ic_cyn_refresh" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <View
                        android:id="@id/viewBelowChooseNumber"
                        android:background="@color/black_300"
                        android:layout_width="0.0dip"
                        android:layout_height="1.0dip"
                        android:layout_marginTop="@dimen/_4dp"
                        android:layout_marginBottom="@dimen/_4dp"
                        android:layout_marginStart="@dimen/_16dp"
                        android:layout_marginEnd="@dimen/_16dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/layoutVasChooseNumber" />
                    <androidx.recyclerview.widget.RecyclerView
                        android:gravity="center"
                        android:id="@id/recycleViewChooseNumber"
                        android:scrollbars="none"
                        android:clipToPadding="false"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_14dp"
                        android:layout_marginBottom="@dimen/_16dp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        app:layout_constrainedHeight="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintEnd_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/viewBelowChooseNumber"
                        app:layout_constraintVertical_bias="0.0" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/clRechargeButton"
            android:background="@drawable/bg_recharge_bottom_btn"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintVertical_bias="1.0">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_24dp"
                android:layout_marginBottom="@dimen/_36dp"
                android:layout_marginStart="@dimen/_16dp"
                android:layout_marginEnd="@dimen/_16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_16sp"
                    android:textColor="@color/black_500"
                    android:gravity="center"
                    android:id="@id/btnBackChooseNumber"
                    android:layout_width="fill_parent"
                    android:layout_height="@dimen/_48dp"
                    android:layout_margin="@dimen/_2dp"
                    android:text="@string/back"
                    android:layout_weight="1.0"
                    android:textAllCaps="false"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTC" />
                <com.google.android.material.button.MaterialButton
                    android:textSize="@dimen/_16sp"
                    android:id="@id/btnProceedChooseNumber"
                    android:layout_width="fill_parent"
                    android:layout_height="@dimen/_48dp"
                    android:layout_margin="@dimen/_2dp"
                    android:text="@string/proceed"
                    android:layout_weight="1.0"
                    android:insetTop="0.0dip"
                    android:insetBottom="0.0dip"
                    android:textAllCaps="false"
                    app:cornerRadius="@dimen/_32dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTC"
                    style="@style/Button_Red_Body.RechargePanel" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
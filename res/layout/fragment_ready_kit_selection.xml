        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_marginTop="@dimen/_16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@id/guidelineStartMarginChooseNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="@dimen/_16dp" />
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@id/guidelineEndMarginChooseNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="@dimen/_16dp" />
        <androidx.constraintlayout.widget.Group
            android:id="@id/groupInputPartChooseNumber"
            android:layout_width="0.0dip"
            android:layout_height="0.0dip"
            app:constraint_referenced_ids="tvDesiredMobileNumberChooseNumber, etDesiredMobileNumberChooseNumber,clSearchChooseNumber" />
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_14sp"
            android:textStyle="bold"
            android:textColor="@color/black_800"
            android:id="@id/tvDesiredMobileNumberChooseNumber"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_22dp"
            android:text="@string/desired_robi_airtel_number"
            app:layout_constraintEnd_toEndOf="@id/guidelineEndMarginChooseNumber"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@id/guidelineStartMarginChooseNumber"
            app:layout_constraintTop_toTopOf="parent" />
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="16.0sp"
            android:textColor="@color/black_800"
            android:id="@id/etDesiredMobileNumberChooseNumber"
            android:background="@drawable/bg_rectangle_shape"
            android:padding="12.0dip"
            android:layout_width="0.0dip"
            android:layout_height="52.0dip"
            android:layout_marginTop="@dimen/_12dp"
            android:hint="01XXX"
            android:maxLength="11"
            android:drawablePadding="@dimen/_2dp"
            android:inputType="number"
            android:drawableStart="@drawable/ic_mobile"
            android:layout_marginStart="@dimen/_16dp"
            android:layout_marginEnd="@dimen/_8dp"
            app:layout_constraintEnd_toStartOf="@id/clSearchChooseNumber"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDesiredMobileNumberChooseNumber" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/clSearchChooseNumber"
            android:background="@drawable/bg_rectangle_shape"
            android:layout_width="51.0dip"
            android:layout_height="@dimen/_52dp"
            android:layout_marginTop="@dimen/_12dp"
            android:layout_marginEnd="@dimen/_16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDesiredMobileNumberChooseNumber">
            <androidx.appcompat.widget.AppCompatImageView
                android:textColor="@color/black"
                android:id="@id/ivSearchChooseNumber"
                android:layout_width="@dimen/_24dp"
                android:layout_height="@dimen/_24dp"
                android:layout_margin="@dimen/_8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_cyn_search" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/clSearchResultsChooseNumber"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:layout_marginTop="@dimen/_16dp"
            android:layout_marginBottom="@dimen/_16dp"
            android:layout_marginStart="@dimen/_16dp"
            android:layout_marginEnd="@dimen/_16dp"
            app:layout_constraintBottom_toTopOf="@id/clRechargeButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/clSearchChooseNumber">
            <androidx.cardview.widget.CardView
                android:layout_width="0.0dip"
                android:layout_height="0.0dip"
                android:layout_margin="@dimen/_4dp"
                app:cardCornerRadius="@dimen/_8dp"
                app:cardElevation="@dimen/_2dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@id/clMiddleChooseNumber"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.constraintlayout.widget.Group
                        android:id="@id/groupSearchPartChooseNumber"
                        android:layout_width="0.0dip"
                        android:layout_height="0.0dip"
                        app:constraint_referenced_ids="ivSuccessChooseNumber, txtAvailableNumberChooseNumber, txtProceedChooseNumber" />

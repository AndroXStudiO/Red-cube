<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_8dp"
    app:cardCornerRadius="@dimen/_12dp"
    app:cardElevation="@dimen/_2dp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:padding="16.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@id/valueGuideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.45" />
        <ImageView
            android:id="@id/icRequestDate"
            android:layout_width="@dimen/_18dp"
            android:layout_height="@dimen/_18dp"
            android:src="@drawable/ic_clock"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <TextView
            android:textSize="@dimen/_12sp"
            android:textColor="@color/black_500"
            android:id="@id/tvRequestLabel"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/request_date"
            android:layout_marginStart="@dimen/_8dp"
            app:layout_constraintBottom_toBottomOf="@id/icRequestDate"
            app:layout_constraintEnd_toStartOf="@id/valueGuideline"
            app:layout_constraintStart_toEndOf="@id/icRequestDate"
            app:layout_constraintTop_toTopOf="@id/icRequestDate" />
        <TextView
            android:textSize="@dimen/_12sp"
            android:textColor="@color/black_500"
            android:id="@id/tvRequestValue"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            app:layout_constraintBaseline_toBaselineOf="@id/tvRequestLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/valueGuideline" />
        <ImageView
            android:id="@id/icNumber"
            android:layout_width="18.0dip"
            android:layout_height="18.0dip"
            android:layout_marginTop="@dimen/_8dp"
            android:src="@drawable/ic_phone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/icRequestDate" />
        <TextView
            android:textSize="@dimen/_12sp"
            android:textColor="@color/black_500"
            android:id="@id/tvNumberLabel"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/number"
            android:layout_marginStart="8.0dip"
            app:layout_constraintBottom_toBottomOf="@id/icNumber"
            app:layout_constraintEnd_toStartOf="@id/valueGuideline"
            app:layout_constraintStart_toEndOf="@id/icNumber"
            app:layout_constraintTop_toTopOf="@id/icNumber" />
        <TextView
            android:textSize="@dimen/_12sp"
            android:textColor="@color/black_500"
            android:id="@id/tvNumberValue"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            app:layout_constraintBaseline_toBaselineOf="@id/tvNumberLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/valueGuideline" />
        <ImageView
            android:id="@id/icTransaction"
            android:layout_width="18.0dip"
            android:layout_height="18.0dip"
            android:layout_marginTop="@dimen/_8dp"
            android:src="@drawable/ic_transaction_id"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/icNumber" />
        <TextView
            android:textSize="@dimen/_12sp"
            android:textColor="@color/black_500"
            android:id="@id/tvTransactionLabel"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/transaction_id"
            android:layout_marginStart="8.0dip"
            app:layout_constraintBottom_toBottomOf="@id/icTransaction"
            app:layout_constraintEnd_toStartOf="@id/valueGuideline"
            app:layout_constraintStart_toEndOf="@id/icTransaction"
            app:layout_constraintTop_toTopOf="@id/icTransaction" />
        <TextView
            android:textSize="@dimen/_12sp"
            android:textColor="@color/black_500"
            android:id="@id/tvTransactionValue"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            app:layout_constraintBaseline_toBaselineOf="@id/tvTransactionLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/valueGuideline" />
        <ImageView
            android:id="@id/icActivity"
            android:layout_width="18.0dip"
            android:layout_height="18.0dip"
            android:layout_marginTop="@dimen/_8dp"
            android:src="@drawable/ic_activation_type"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/icTransaction" />
        <TextView
            android:textSize="@dimen/_12sp"
            android:textColor="@color/black_500"
            android:id="@id/tvActivityLabel"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/activity_type"
            android:layout_marginStart="8.0dip"
            app:layout_constraintBottom_toBottomOf="@id/icActivity"
            app:layout_constraintEnd_toStartOf="@id/valueGuideline"
            app:layout_constraintStart_toEndOf="@id/icActivity"
            app:layout_constraintTop_toTopOf="@id/icActivity" />
        <TextView
            android:textSize="@dimen/_12sp"
            android:textColor="@color/black_500"
            android:id="@id/tvActivityValue"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            app:layout_constraintBaseline_toBaselineOf="@id/tvActivityLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/valueGuideline" />
        <com.google.android.material.button.MaterialButton
            android:textSize="16.0sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@id/btnChange"
            android:layout_width="0.0dip"
            android:layout_height="48.0dip"
            android:layout_marginTop="@dimen/_18dp"
            android:text="@string/change"
            android:insetTop="0.0dip"
            android:insetBottom="0.0dip"
            android:textAllCaps="false"
            app:backgroundTint="@color/primary"
            app:cornerRadius="32.0dip"
            app:icon="@drawable/ic_change"
            app:iconGravity="textStart"
            app:iconPadding="8.0dip"
            app:iconTint="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/icActivity" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
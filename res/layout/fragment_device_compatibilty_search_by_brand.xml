<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/main"
    android:background="@color/base_background"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/clBrandInfo"
        android:background="@color/base_background"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/app_bar_layout"
            android:background="@color/app_bar_bg"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_16dp"
            android:layout_marginEnd="@dimen/_16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_14sp"
                android:textStyle="bold"
                android:textColor="@color/grey_800"
                android:id="@id/tvTitle"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16dp"
                android:text="@string/device_esim_compatibility_check"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <androidx.cardview.widget.CardView
                android:id="@id/cvSearchView"
                android:background="@color/white"
                android:layout_width="0.0dip"
                android:layout_height="@dimen/_52dp"
                android:layout_marginTop="@dimen/_10dp"
                android:layout_marginBottom="@dimen/_4dp"
                android:layout_marginStart="@dimen/_4dp"
                android:layout_marginEnd="@dimen/_4dp"
                app:cardCornerRadius="@dimen/_8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTitle">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@id/ivSearch"
                        android:layout_width="18.0dip"
                        android:layout_height="18.0dip"
                        android:layout_marginStart="@dimen/_12dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_search" />
                    <androidx.appcompat.widget.AppCompatEditText
                        android:textSize="@dimen/_14sp"
                        android:textColorHint="@color/light_grey"
                        android:id="@id/etSearch"
                        android:background="@null"
                        android:layout_width="0.0dip"
                        android:layout_height="0.0dip"
                        android:hint="@string/brand_name"
                        android:inputType="text"
                        android:imeOptions="actionNext"
                        android:nextFocusForward="@id/etAmount"
                        android:paddingStart="@dimen/_4dp"
                        android:paddingEnd="@dimen/_4dp"
                        android:layout_marginStart="@dimen/_8dp"
                        android:layout_marginEnd="@dimen/_8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/ivSearch"
                        app:layout_constraintTop_toTopOf="parent" />
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@id/clCross"
                        android:layout_width="@dimen/_40dp"
                        android:layout_height="0.0dip"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="18.0dip"
                            android:layout_height="18.0dip"
                            android:layout_marginEnd="@dimen/_12dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@drawable/ic_cross_circle" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/clResults"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:layout_marginTop="@dimen/_8dp"
            android:layout_marginBottom="@dimen/_16dp"
            android:layout_marginEnd="@dimen/_16dp"
            app:layout_constraintBottom_toTopOf="@id/clProceed"
            app:layout_constraintTop_toBottomOf="@id/app_bar_layout">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@id/rvResults"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constrainedHeight="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/clProceed"
            android:background="@drawable/bg_recharge_bottom_btn"
            android:layout_width="fill_parent"
            android:layout_height="108.0dip"
            app:layout_constraintBottom_toBottomOf="parent">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/llButton"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16dp"
                android:layout_marginBottom="@dimen/_16dp"
                android:layout_marginStart="@dimen/_16dp"
                android:layout_marginEnd="@dimen/_16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_16sp"
                    android:textColor="@color/black_500"
                    android:gravity="center"
                    android:id="@id/btnBack"
                    android:layout_width="0.0dip"
                    android:layout_height="@dimen/_48dp"
                    android:layout_margin="@dimen/_2dp"
                    android:text="@string/back"
                    android:layout_weight="1.0"
                    android:textAllCaps="false" />
                <com.google.android.material.button.MaterialButton
                    android:textSize="@dimen/_16sp"
                    android:id="@id/btnProceed"
                    android:layout_width="0.0dip"
                    android:layout_height="@dimen/_48dp"
                    android:layout_margin="@dimen/_2dp"
                    android:text="@string/proceed"
                    android:layout_weight="1.0"
                    android:insetTop="0.0dip"
                    android:insetBottom="0.0dip"
                    android:textAllCaps="false"
                    app:cornerRadius="@dimen/_32dp"
                    style="@style/Button_Red_Body.RechargePanel" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/clModelInfo"
        android:background="@color/base_background"
        android:visibility="invisible"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@color/base_background"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@id/app_bar_layout_model_info"
                android:background="@color/app_bar_bg"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_16dp"
                android:layout_marginEnd="@dimen/_16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_14sp"
                    android:textStyle="bold"
                    android:textColor="@color/grey_800"
                    android:id="@id/tvTitle_model_info"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_16dp"
                    android:text="@string/device_esim_compatibility_check"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <androidx.cardview.widget.CardView
                    android:id="@id/cvSearchView_model_info"
                    android:background="@color/white"
                    android:layout_width="0.0dip"
                    android:layout_height="@dimen/_52dp"
                    android:layout_marginTop="@dimen/_10dp"
                    android:layout_marginBottom="@dimen/_4dp"
                    android:layout_marginStart="@dimen/_4dp"
                    android:layout_marginEnd="@dimen/_16dp"
                    app:cardCornerRadius="@dimen/_8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTitle_model_info">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@id/ivSearch_model_info"
                            android:layout_width="18.0dip"
                            android:layout_height="18.0dip"
                            android:layout_marginStart="@dimen/_12dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@drawable/ic_search" />
                        <androidx.appcompat.widget.AppCompatEditText
                            android:textSize="@dimen/_14sp"
                            android:textColorHint="@color/light_grey"
                            android:id="@id/etSearch_model_info"
                            android:background="@null"
                            android:layout_width="0.0dip"
                            android:layout_height="0.0dip"
                            android:hint="@string/model_name"
                            android:inputType="text"
                            android:imeOptions="actionNext"
                            android:nextFocusForward="@id/etAmount"
                            android:paddingStart="@dimen/_4dp"
                            android:paddingEnd="@dimen/_4dp"
                            android:layout_marginStart="@dimen/_8dp"
                            android:layout_marginEnd="@dimen/_8dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/ivSearch_model_info"
                            app:layout_constraintTop_toTopOf="parent" />
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@id/clCross_model_info"
                            android:layout_width="@dimen/_40dp"
                            android:layout_height="0.0dip"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="18.0dip"
                                android:layout_height="18.0dip"
                                android:layout_marginEnd="@dimen/_12dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:srcCompat="@drawable/ic_cross_circle" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_16sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@id/tvSelectedBrand"
                android:background="@drawable/bg_suggestion"
                android:paddingTop="@dimen/_8dp"
                android:paddingBottom="@dimen/_8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10dp"
                android:layout_marginBottom="@dimen/_6dp"
                android:text="Apple"
                android:paddingStart="@dimen/_12dp"
                android:paddingEnd="@dimen/_12dp"
                android:layout_marginStart="@dimen/_16dp"
                android:layout_marginEnd="@dimen/_4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/app_bar_layout_model_info" />
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@id/clResults_model_info"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:layout_marginTop="@dimen/_24dp"
                android:layout_marginBottom="@dimen/_16dp"
                android:layout_marginStart="@dimen/_16dp"
                android:layout_marginEnd="@dimen/_16dp"
                app:layout_constraintBottom_toTopOf="@id/clProceed_model_info"
                app:layout_constraintTop_toBottomOf="@id/tvSelectedBrand">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@id/rvResults_model_info"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constrainedHeight="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.0" />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@id/clProceed_model_info"
                android:background="@drawable/bg_recharge_bottom_btn"
                android:layout_width="fill_parent"
                android:layout_height="108.0dip"
                app:layout_constraintBottom_toBottomOf="parent">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@id/llButton_model_info"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_16dp"
                    android:layout_marginBottom="@dimen/_16dp"
                    android:layout_marginStart="@dimen/_16dp"
                    android:layout_marginEnd="@dimen/_16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_16sp"
                        android:textColor="@color/black_500"
                        android:gravity="center"
                        android:id="@id/btnBack_model_info"
                        android:layout_width="0.0dip"
                        android:layout_height="@dimen/_48dp"
                        android:layout_margin="@dimen/_2dp"
                        android:text="@string/back"
                        android:layout_weight="1.0"
                        android:textAllCaps="false" />
                    <com.google.android.material.button.MaterialButton
                        android:textSize="@dimen/_16sp"
                        android:id="@id/btnProceed_model_info"
                        android:layout_width="0.0dip"
                        android:layout_height="@dimen/_48dp"
                        android:layout_margin="@dimen/_2dp"
                        android:text="@string/proceed"
                        android:layout_weight="1.0"
                        android:insetTop="0.0dip"
                        android:insetBottom="0.0dip"
                        android:textAllCaps="false"
                        app:cornerRadius="@dimen/_32dp"
                        style="@style/Button_Red_Body.RechargePanel" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
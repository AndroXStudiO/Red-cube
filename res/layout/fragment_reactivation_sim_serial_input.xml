<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@id/guidelineStartMargin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/_16dp" />
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@id/guidelineEndMargin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/_16dp" />
    <androidx.constraintlayout.widget.Group
        android:id="@id/groupMobileNumberInput"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        app:constraint_referenced_ids="tvEnterMobile, btnScan, etCustomerMobile" />
    <com.google.android.material.button.MaterialButton
        android:enabled="true"
        android:textSize="@dimen/_14sp"
        android:id="@id/btnScan"
        android:layout_width="0.0dip"
        android:layout_height="@dimen/_36dp"
        android:layout_marginTop="@dimen/_22dp"
        android:text="@string/scan"
        android:insetTop="0.0dip"
        android:insetBottom="0.0dip"
        android:textAllCaps="false"
        android:paddingStart="@dimen/_12dp"
        android:paddingEnd="@dimen/_12dp"
        app:cornerRadius="@dimen/_42dp"
        app:icon="@drawable/ic_scan"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/_4dp"
        app:iconTint="@color/text_color_red_grey_recharge_panel"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        style="@style/Button_Red_Border_Only.RechargePanel" />
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/_14sp"
        android:textStyle="bold"
        android:textColor="@color/black_800"
        android:id="@id/tvEnterMobile"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/input_serial_number"
        app:layout_constraintBottom_toBottomOf="@id/btnScan"
        app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
        app:layout_constraintTop_toTopOf="@id/btnScan" />
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="16.0sp"
        android:textColor="@color/black_800"
        android:id="@id/etCustomerMobile"
        android:background="@drawable/bg_number_input"
        android:padding="12.0dip"
        android:layout_width="fill_parent"
        android:layout_height="52.0dip"
        android:layout_margin="16.0dip"
        android:layout_marginTop="@dimen/_12dp"
        android:hint="XXX"
        android:maxLength="17"
        android:drawablePadding="@dimen/_2dp"
        android:inputType="number"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnScan" />
    <androidx.constraintlayout.widget.Group
        android:id="@id/groupMobileNumberShow"
        android:visibility="gone"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        app:constraint_referenced_ids="tvMobileNumber, etMobileNumber,tvSerialNumber,etSerialNumber" />
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/_14sp"
        android:textStyle="bold"
        android:textColor="@color/black_800"
        android:id="@id/tvMobileNumber"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_22dp"
        android:text="@string/mobile_number"
        app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
        app:layout_constraintTop_toTopOf="parent" />
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="16.0sp"
        android:textColor="@color/black_800"
        android:id="@id/etMobileNumber"
        android:background="@drawable/bg_offer_selected"
        android:padding="12.0dip"
        android:layout_width="fill_parent"
        android:layout_height="52.0dip"
        android:layout_margin="16.0dip"
        android:layout_marginTop="@dimen/_12dp"
        android:hint="01XXX"
        android:drawablePadding="@dimen/_2dp"
        android:inputType="number"
        android:drawableStart="@drawable/ic_mobile"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvMobileNumber" />
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/_14sp"
        android:textStyle="bold"
        android:textColor="@color/black_800"
        android:id="@id/tvSerialNumber"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_16dp"
        android:text="@string/serial_number"
        app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
        app:layout_constraintTop_toBottomOf="@id/etMobileNumber" />
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="16.0sp"
        android:textColor="@color/black_800"
        android:id="@id/etSerialNumber"
        android:background="@drawable/bg_offer_selected"
        android:padding="12.0dip"
        android:layout_width="fill_parent"
        android:layout_height="52.0dip"
        android:layout_margin="16.0dip"
        android:layout_marginTop="@dimen/_12dp"
        android:hint="XXX"
        android:drawablePadding="@dimen/_2dp"
        android:inputType="number"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSerialNumber" />
</androidx.constraintlayout.widget.ConstraintLayout>
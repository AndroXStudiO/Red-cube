<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@color/even_row_color"
    android:paddingBottom="@dimen/_16dp"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/_14sp"
        android:textStyle="bold"
        android:textColor="@color/black_800"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20dp"
        android:text="@string/other_dates"
        android:layout_marginStart="@dimen/_16dp"
        android:layout_marginEnd="@dimen/_16dp" />
    <androidx.cardview.widget.CardView
        android:id="@id/cvSearchView"
        android:background="@color/white"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/_40dp"
        android:layout_marginTop="@dimen/_10dp"
        android:layout_marginStart="@dimen/_16dp"
        android:layout_marginEnd="@dimen/_16dp"
        app:cardCornerRadius="@dimen/_8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@id/ivSearch"
                android:layout_width="18.0dip"
                android:layout_height="18.0dip"
                android:layout_marginStart="@dimen/_12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_search" />
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="@dimen/_14sp"
                android:textColorHint="@color/black_500"
                android:id="@id/etSearch"
                android:background="@null"
                android:layout_width="0.0dip"
                android:layout_height="0.0dip"
                android:hint="@string/search_msisdn_grid_and_type"
                android:inputType="text"
                android:imeOptions="actionNext"
                android:nextFocusForward="@id/etAmount"
                android:paddingStart="@dimen/_4dp"
                android:paddingEnd="@dimen/_4dp"
                android:layout_marginStart="@dimen/_8dp"
                android:layout_marginEnd="@dimen/_8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivSearch"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:id="@id/cvHeaderDate"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10dp"
        android:minHeight="@dimen/_48dp"
        android:layout_marginStart="@dimen/_16dp"
        android:layout_marginEnd="@dimen/_16dp"
        app:cardCornerRadius="@dimen/_8dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@id/clDateHeader"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_12sp"
                    android:textColor="@color/black_500"
                    android:id="@id/textDateShow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sort by"
                    android:layout_marginStart="@dimen/_12dp"
                    android:layout_marginEnd="8.0dip"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_12sp"
                    android:textStyle="bold"
                    android:textColor="@color/black_800"
                    android:id="@id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date, Grid ID"
                    android:layout_marginStart="8.0dip"
                    android:layout_marginEnd="8.0dip"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintEnd_toStartOf="@id/imageViewDate"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toEndOf="@id/textDateShow"
                    app:layout_constraintTop_toTopOf="parent" />
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@id/imageViewDate"
                    android:layout_width="@dimen/_20dp"
                    android:layout_height="@dimen/_20dp"
                    android:layout_marginEnd="@dimen/_14_5dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_calender" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/dataRowHeader"
        android:paddingTop="@dimen/_8dp"
        android:paddingBottom="@dimen/_8dp"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10dp"
        android:paddingStart="@dimen/_16dp"
        android:paddingEnd="@dimen/_16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/_8sp"
            android:textStyle="normal"
            android:textColor="@color/black_800"
            android:gravity="start"
            android:layout_gravity="center_vertical"
            android:id="@id/dataDate"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/time"
            android:layout_weight="1.2" />
        <TextView
            android:textSize="@dimen/_8sp"
            android:textStyle="normal"
            android:textColor="@color/black_800"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@id/dataMsisdn"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/msisdn_bn"
            android:layout_weight="1.0" />
        <TextView
            android:textSize="@dimen/_8sp"
            android:textStyle="normal"
            android:textColor="@color/black_800"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@id/dataType"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/type"
            android:layout_weight="1.0" />
        <TextView
            android:textSize="@dimen/_8sp"
            android:textStyle="normal"
            android:textColor="@color/black_800"
            android:gravity="end"
            android:layout_gravity="center_vertical"
            android:id="@id/dataGridId"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/grid_id"
            android:layout_weight="0.8" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@id/rvResults"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
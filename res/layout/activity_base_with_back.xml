<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/main_layout"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/app_bar_layout"
        android:background="@color/app_bar_bg"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/_52dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/layoutBack"
            android:layout_width="@dimen/_44dp"
            android:layout_height="@dimen/_44dp"
            android:layout_marginStart="@dimen/_4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@id/ivBack"
                android:padding="@dimen/_4dp"
                android:layout_width="@dimen/_24dp"
                android:layout_height="@dimen/_24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_back" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_16sp"
            android:textStyle="bold"
            android:textColor="@color/black_900"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@id/txtTitle"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:scrollHorizontally="true"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/cvBalanceView"
            app:layout_constraintStart_toEndOf="@id/layoutBack"
            app:layout_constraintTop_toTopOf="parent" />
        <androidx.cardview.widget.CardView
            android:id="@id/cvBalanceView"
            android:background="@color/white"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_28dp"
            android:layout_marginStart="@dimen/_4dp"
            android:layout_marginEnd="@dimen/_16dp"
            app:cardCornerRadius="100.0dip"
            app:cardElevation="@dimen/_2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toEndOf="@id/txtTitle"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@id/layoutBalance"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginStart="@dimen/_8dp"
                android:layout_marginEnd="@dimen/_8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@id/ivRobiBrand"
                    android:padding="@dimen/_2dp"
                    android:layout_width="@dimen/_16dp"
                    android:layout_height="@dimen/_16dp"
                    android:scaleType="centerInside"
                    android:layout_marginEnd="@dimen/_4dp"
                    app:srcCompat="@drawable/ic_brand_robi" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_12sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@id/tvPrimaryBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:drawablePadding="@dimen/_2dp"
                    android:layout_marginEnd="@dimen/_6dp" />
                <View
                    android:id="@id/view1"
                    android:background="@color/divider_grey"
                    android:layout_width="@dimen/_1dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6dp"
                    android:layout_marginBottom="@dimen/_6dp"
                    android:layout_marginEnd="@dimen/_5dp" />
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@id/ivAirtedlBrand"
                    android:padding="@dimen/_2dp"
                    android:layout_width="@dimen/_16dp"
                    android:layout_height="@dimen/_16dp"
                    android:scaleType="centerInside"
                    android:layout_marginEnd="@dimen/_4dp"
                    app:srcCompat="@drawable/ic_brand_airtel" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_12sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@id/tvSecondaryBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:singleLine="true" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@id/activity_container"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/app_bar_layout" />
</androidx.constraintlayout.widget.ConstraintLayout>
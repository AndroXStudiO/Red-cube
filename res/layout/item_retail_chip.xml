<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/clMain"
    android:background="@drawable/retail_background"
    android:paddingTop="8.0dip"
    android:paddingBottom="8.0dip"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_3dp"
    android:paddingStart="@dimen/_4dp"
    android:paddingEnd="@dimen/_4dp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@id/checkmarkIcon"
        android:layout_width="@dimen/_18dp"
        android:layout_height="@dimen/_18dp"
        android:src="@drawable/ic_tick_white"
        android:layout_marginEnd="@dimen/_4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/gridChipTextView"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:textSize="@dimen/_12sp"
        android:textStyle="normal"
        android:textColor="@color/chip_text_color"
        android:id="@id/gridChipTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="42616"
        android:layout_marginStart="@dimen/_4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/checkmarkIcon"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ScrollView
        android:id="@id/svAddress"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        app:layout_constraintBottom_toTopOf="@id/clRechargeButton"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="@dimen/_12dp"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@id/guidelineStartMargin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_begin="@dimen/_16dp" />
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@id/guidelineEndMargin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_end="@dimen/_16dp" />
            <androidx.constraintlayout.widget.Group
                android:id="@id/PhotoInformation"
                android:layout_width="0.0dip"
                android:layout_height="0.0dip"
                app:constraint_referenced_ids="clCustomerPhoto, viewCustomerPhoto,clFirstPagePassport,viewFirstPageOfPassport,clRenewedVisa,viewRenewedVisa" />
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@id/clCustomerPhoto"
                android:layout_width="0.0dip"
                android:layout_height="@dimen/_52dp"
                android:layout_margin="@dimen/_4dp"
                android:layout_marginTop="@dimen/_10dp"
                app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
                app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:textColor="@color/black"
                    android:id="@id/ivCheck1"
                    android:layout_width="@dimen/_24dp"
                    android:layout_height="@dimen/_24dp"
                    android:layout_margin="@dimen/_8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_round_tick_filled" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_14sp"
                    android:textStyle="bold"
                    android:textColor="@color/black_800"
                    android:id="@id/tvUploadNoc"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/customer_photo"
                    android:layout_marginStart="@dimen/_8dp"
                    android:layout_marginEnd="16.0dip"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ivCheck1"
                    app:layout_constraintTop_toTopOf="parent" />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@id/clCustomerImg"
                    android:background="@drawable/bg_rectangle_shape"
                    android:layout_width="98.0dip"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:textColor="@color/black"
                        android:id="@id/ivUploadOne"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_2dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_camera" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_12sp"
                        android:textStyle="normal"
                        android:textColor="@color/black_500"
                        android:gravity="center_horizontal"
                        android:id="@id/tvEditText"
                        android:padding="@dimen/_4dp"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/capture"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/ivUploadOne"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:id="@id/viewCustomerPhoto"
                android:background="@color/black_300"
                android:layout_width="0.0dip"
                android:layout_height="1.0dip"
                android:layout_marginTop="@dimen/_4dp"
                android:layout_marginBottom="@dimen/_4dp"
                app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
                app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
                app:layout_constraintTop_toBottomOf="@id/clCustomerPhoto" />
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@id/clFirstPagePassport"
                android:layout_width="0.0dip"
                android:layout_height="@dimen/_52dp"
                android:layout_margin="@dimen/_4dp"
                app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
                app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
                app:layout_constraintTop_toBottomOf="@id/viewCustomerPhoto">
                <androidx.appcompat.widget.AppCompatImageView
                    android:textColor="@color/black"
                    android:id="@id/ivCheck2"
                    android:layout_width="@dimen/_24dp"
                    android:layout_height="@dimen/_24dp"
                    android:layout_margin="@dimen/_8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_round_tick_filled" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_14sp"
                    android:textStyle="bold"
                    android:textColor="@color/black_800"
                    android:id="@id/tvFirstPagePassport"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/first_page_of_passport"
                    android:layout_marginStart="@dimen/_8dp"
                    android:layout_marginEnd="16.0dip"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ivCheck2"
                    app:layout_constraintTop_toTopOf="parent" />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@id/clPassportImg"
                    android:background="@drawable/bg_rectangle_shape"
                    android:layout_width="98.0dip"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:textColor="@color/black"
                        android:id="@id/ivFirstPagePassport"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_2dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_camera" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_12sp"
                        android:textStyle="normal"
                        android:textColor="@color/black_500"
                        android:gravity="center_horizontal"
                        android:padding="@dimen/_4dp"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/capture"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/ivFirstPagePassport"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:id="@id/viewFirstPageOfPassport"
                android:background="@color/black_300"
                android:layout_width="0.0dip"
                android:layout_height="1.0dip"
                android:layout_marginTop="@dimen/_4dp"
                android:layout_marginBottom="@dimen/_4dp"
                app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
                app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
                app:layout_constraintTop_toBottomOf="@id/clFirstPagePassport" />
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@id/clRenewedVisa"
                android:layout_width="0.0dip"
                android:layout_height="@dimen/_52dp"
                android:layout_margin="@dimen/_4dp"
                app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
                app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
                app:layout_constraintTop_toBottomOf="@id/viewFirstPageOfPassport">
                <androidx.appcompat.widget.AppCompatImageView
                    android:textColor="@color/black"
                    android:id="@id/ivCheck3"
                    android:layout_width="@dimen/_24dp"
                    android:layout_height="@dimen/_24dp"
                    android:layout_margin="@dimen/_8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_round_tick_filled" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_14sp"
                    android:textStyle="bold"
                    android:textColor="@color/black_800"
                    android:id="@id/tvRenewedVisa"
                    android:visibility="visible"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:text="@string/renewed_visa_with_new_expiry"
                    android:layout_marginStart="@dimen/_8dp"
                    android:layout_marginEnd="16.0dip"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/clCaptureRenewedVisa"
                    app:layout_constraintStart_toEndOf="@id/ivCheck3"
                    app:layout_constraintTop_toTopOf="parent" />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@id/clCaptureRenewedVisa"
                    android:background="@drawable/bg_rectangle_shape"
                    android:layout_width="98.0dip"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:textColor="@color/black"
                        android:id="@id/ivRenewedVisa"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_2dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_camera" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_12sp"
                        android:textStyle="normal"
                        android:textColor="@color/black_500"
                        android:gravity="center_horizontal"
                        android:padding="@dimen/_4dp"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/capture"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/ivRenewedVisa"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:id="@id/viewRenewedVisa"
                android:background="@color/black_300"
                android:layout_width="0.0dip"
                android:layout_height="1.0dip"
                android:layout_marginTop="@dimen/_4dp"
                android:layout_marginBottom="@dimen/_4dp"
                app:layout_constraintEnd_toEndOf="@id/guidelineEndMargin"
                app:layout_constraintStart_toStartOf="@id/guidelineStartMargin"
                app:layout_constraintTop_toBottomOf="@id/clRenewedVisa" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/clRechargeButton"
        android:background="@drawable/bg_recharge_bottom_btn"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/_8dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/svAddress"
        app:layout_constraintVertical_bias="1.0">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/black_500"
            android:gravity="center"
            android:id="@id/tvTC"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/_48dp"
            android:layout_margin="@dimen/_16dp"
            android:text="@string/by_proceeding_you_are_agreeing_to_our_terms_and_conditions"
            android:layout_weight="1.0"
            android:textAllCaps="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16dp"
            android:layout_marginBottom="@dimen/_16dp"
            android:layout_marginStart="@dimen/_16dp"
            android:layout_marginEnd="@dimen/_16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTC">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/_16sp"
                android:textColor="@color/black_500"
                android:gravity="center"
                android:id="@id/btnBack"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/_48dp"
                android:layout_margin="@dimen/_2dp"
                android:text="@string/back"
                android:layout_weight="1.0"
                android:textAllCaps="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTC" />
            <com.google.android.material.button.MaterialButton
                android:textSize="@dimen/_16sp"
                android:id="@id/btnRecharge"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/_48dp"
                android:layout_margin="@dimen/_2dp"
                android:text="@string/generate_otp"
                android:layout_weight="1.0"
                android:insetTop="0.0dip"
                android:insetBottom="0.0dip"
                android:textAllCaps="false"
                app:cornerRadius="@dimen/_32dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTC"
                style="@style/Button_Red_Body.RechargePanel" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
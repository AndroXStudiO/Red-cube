<?xml version="1.0" encoding="utf-8"?>
<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape
            android:shape="rectangle">
            <corners
                android:radius="32.0dip" />
            <stroke
                android:width="4.0dip"
                android:color="#ffffd6d7" />
            <solid
                android:color="@android:color/transparent" />
        </shape>
    </item>
    <item
        android:left="4.0dip"
        android:top="4.0dip"
        android:right="4.0dip"
        android:bottom="4.0dip">
        <shape
            android:shape="rectangle">
            <corners
                android:radius="30.0dip" />
            <stroke
                android:width="1.0dip"
                android:color="@color/primary" />
            <solid
                android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>